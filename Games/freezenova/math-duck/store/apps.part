dcom.airvisual\u0026rdid\u003dcom.airvisual\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,"/store/apps/details?id\u003dcom.airvisual"]],["qgKLARqIAQgIShMImozA7Z/plgMVqKWDAx1qqROt+gEPCg0IABIJCgVlbi1VUxAAugRcChMKDWNvbS5haXJ2aXN1YWwQARgDGjgKMW1jX29ycGhhbl93aWxkZmlyZV9haXJfcXVhbGl0eV9zYWZldHlfMjAyNl8wOF9mY2MQmQEYAyILCgASBzEyNTdiNTc\u003d"],null,[null,"The most trusted and reliable air quality information from the world’s leading air pollution data provider. Covering 500,000+ locations from a global network of government monitoring stations and IQAir\u0026#39;s own validated sensors.\u003cbr\u003e\u003cbr\u003eRecommended for sensitive people (allergies, asthma, etc), a must-have for families and great for athletes, runners, cyclists and outdoor sports activities. Plan the healthiest day with health recommendations, 48-hour forecasts, and check the real-time global air quality map. Learn what pollutants you are breathing, their sources and effects and stay informed about key air quality and wildfire breakouts in your area.\u003cbr\u003e\u003cbr\u003e+ Historical, Real-time, and Forecast Air Pollution Data: Detailed figures on key pollutants and AQI for over 500,000+ locations in 100+ countries, made clearly understandable. Follow air pollution trends with enhanced month-long and 48h historical views for your favorite locations.\u003cbr\u003e\u003cbr\u003e+ Leading 7-Day Air Pollution and Weather Forecast: For the first time, plan your outdoor activities for the healthiest experiences a whole week ahead. Wind direction and speed forecasts to understand the wind’s impact on pollution.\u003cbr\u003e\u003cbr\u003e+ 2D \u0026amp; 3D World Pollution Maps: Explore real-time pollution indexes around the globe, both in a 2D panoramic view, and mesmerizing heatmapped AirVisual Earth 3D modelization.\u003cbr\u003e\u003cbr\u003e+ Health Recommendations: Follow our advice to lower your health risk and achieve minimum exposure to pollutants. Relevant information for sensitive groups with asthma or other respiratory (pulmonary) diseases.\u003cbr\u003e\u003cbr\u003e+ Weather Information: Your one-stop for temperature, humidity, wind, current conditions and forecast weather information.\u003cbr\u003e\u003cbr\u003e+ Wildfire and air quality events: Stay informed on wildfires, smoke, and air quality events worldwide. See alerts and track events on an interactive map with real-time \u0026amp; historical data, forecasts, news updates, and more.\u003cbr\u003e\u003cbr\u003e+ Pollen counts: View tree, weed \u0026amp; grass pollen counts for your favorite places and protect yourself from allergies. Plan your outdoor activities with 3-day forecasts.\u003cbr\u003e\u003cbr\u003e+ Realtime and Historic Monitoring of 6 Key Pollutants: Track live concentrations of PM2.5, PM10, ozone, nitrogen dioxide, sulphur dioxide and carbon monoxide, and observe pollutants historical trends.\u003cbr\u003e\u003cbr\u003e+ Real-time air pollution city ranking: Track the best and worst cities by air quality and pollution for 100+ locations worldwide, based on live PM2.5 concentrations.\u003cbr\u003e\u003cbr\u003e+ “Sensitive Group” Air Quality Information: Relevant information and forecasts for sensitive groups, including respiratory (pulmonary) illnesses, such as asthma.\u003cbr\u003e\u003cbr\u003e+ Extended Historical Data Graphs: View air pollution trends over the past 48 hours, or daily averages over the past month. \u003cbr\u003e\u003cbr\u003e+ Control your air purifier: Remotely control \u0026amp; monitor your Atem X \u0026amp; HealthPro series air purifiers for safer indoor air quality with live \u0026amp; historical data, comparisons, filter replacement alerts, scheduled on/off and more.\u003cbr\u003e\u003cbr\u003e+ Indoor \u0026amp; Outdoor Air Quality Monitoring: Synchronization with IQAir AirVisual Pro and AirVisual Outdoor air monitors to provide readings, recommendations, and control monitor settings.\u003cbr\u003e\u003cbr\u003e+ Air Pollution Community News: Stay up to date on air pollution current events, medical findings, and developments in combating global air pollution. \u003cbr\u003e\u003cbr\u003e+ Educational Resources: Build your understanding of PM2.5 and other air pollutants and learn how best to live in polluted environments with respiratory (pulmonary) illnesses such as asthma. \u003cbr\u003e\u003cbr\u003e+ Worldwide coverage with the most extensive network of air pollution sensors: monitor United States, China, India, Singapore, Japan, Korea, Canada, Australia, Mexico, Brazil, France, Hong Kong, Thailand, Indonesia, Chile, Turkey, Germany + more - as well as cities such as Los Angeles, Sacramento, New York, Chicago, Houston, Phoenix, Philadelphia, San FranciscoSeoul, Mumbai, New Delhi, Tokyo, Mexico City, Bangkok, London, , Paris, Berlin, Ho Chi Minh City, Chiang Mai + more - in one place!"],"IQAir AG","5,000,000+",null,"",null,null,null,null,[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/jQrzJHXPVNScKiJ3tx_F1ifYm4EQo7B7LdTssYUGb8E2gOvQDaj5yVU8okDrqGB7PMdenavkVtoDOAxru_LZ"],null,[8,27,47,255]],null,["Everyone",[null,2,[512,512],[null,null,"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i"]],null,null,[null,"\u003ca href\u003d\"https://support.google.com/googleplay?p\u003dappgame_ratings\"\u003eLearn more\u003c/a\u003e"],0,[null,"Content is generally suitable for all ages. May contain minimal cartoon, fantasy or mild violence and/or infrequent use of mild language."],[null,2,[272,272],[null,null,"https://play-lh.googleusercontent.com/OBVqgRK7eerY0GPfK8AOzitu5oE9ecC6kG4kURTCb1K41gpqVsN0WjmJwJh-wX8vILzpcc1kYHt56aLN2g"]],[null,null,null,null,null,[null,null,"https://support.google.com/googleplay?p\u003dappgame_ratings"]]],[[[[[null,[[0,"USD",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.airvisual\u0026rdid\u003dcom.airvisual\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]]],["Install"],null,["CgYKBENBRT0\u003d"]]]],[2],null,[1,1,0]],[[null,null,null,null,[null,null,"/store/apps/details?id\u003dcom.airvisual"]],["qgKLARqIAQgIShMImozA7Z/plgMVqKWDAx1qqROt+gEPCg0IABIJCgVlbi1VUxAAugRcChMKDWNvbS5haXJ2aXN1YWwQARgDGjgKMW1jX29ycGhhbl93aWxkZmlyZV9haXJfcXVhbGl0eV9zYWZldHlfMjAyNl8wOF9mY2MQmQEYAyILCgASBzEyNTdiNTc\u003d"],[[null,[[0,"USD",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.airvisual\u0026rdid\u003dcom.airvisual\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]]]],[null,"Clear the air this season"],[null,"Navigate wildfire smoke with ease"],[null,2,[2160,3840],[null,null,"https://play-lh.googleusercontent.com/7z9FPv0BLhXRJ2IcK49kpwcRBWHob-su6aVOVbJNFTtYksjEfDEu6qBd57vExag4dUf4hAOnbkXv"],null,[196,238,208,255]],null,"Trending",[null,null,null,null,[null,null,"/store/apps/editorial?id\u003dmc_wildfire_air_quality_safety_2026_08_fcp"]],1,null,["IQAir AirVisual | Air Quality"],[[["Weather",[null,null,null,null,[null,null,"/store/apps/category/WEATHER"]],"WEATHER"]]]]],[null,[[["com.usfoodrecalls.android",7],[null,2,[512,512],[null,null,"https://play-lh.googleusercontent.com/E-Ocwzr2rz4WEfuUncs279xUYGV5Ib5ZhYVZjizWIucw43TIJY8Fdv11t9ggkLDHSVzhpeYRL3IGiuIXNoumZks"],null,[245,244,0,255],null,null,null,2],[[null,2,[2208,1242],[null,null,"https://play-lh.googleusercontent.com/F107UPKTof_HQEem0CFXV7Xuyu7D-CD9rRsiTHMKF0A7x85SwYzAUZrmzoH-TNcOXZIRVrwadYPTx3mU8fNF"]],[null,2,[2208,1242],[null,null,"https://play-lh.googleusercontent.com/c4wdkgsMwTaKuOLoypOSe5IXSSOf4MubVwgAkOpwiph6Zne0IdoeWhEMJ7ApVduPA8Vd8tbXY-hoLr7kufF_9g"]],[null,2,[2208,1242],[null,null,"https://play-lh.googleusercontent.com/enbPtk3gI21wxL6GuZ7oLQlcYfptIAa0xDrw9GI0PbFzPqwZv41w7_gaVgqSOlSm763nSty8PrB3QNb0XETW7es"]],[null,2,[2208,1242],[null,null,"https://play-lh.googleusercontent.com/Vy_YB-b4wRzCnbly4WgZxMD6IvzHSQjaVtMoD9z-lpf12bWLzKPVldvAzcSxhEPd15xR3feoZzCWhenW5uodnQ"]],[null,2,[2208,1242],[null,null,"https://play-lh.googleusercontent.com/F107UPKTof_HQEem0CFXV7Xuyu7D-CD9rRsiTHMKF0A7x85SwYzAUZrmzoH-TNcOXZIRVrwadYPTx3mU8fNF"]],[null,2,[2208,1242],[null,null,"https://play-lh.googleusercontent.com/c4wdkgsMwTaKuOLoypOSe5IXSSOf4MubVwgAkOpwiph6Zne0IdoeWhEMJ7ApVduPA8Vd8tbXY-hoLr7kufF_9g"]],[null,2,[2208,1242],[null,null,"https://play-lh.googleusercontent.com/enbPtk3gI21wxL6GuZ7oLQlcYfptIAa0xDrw9GI0PbFzPqwZv41w7_gaVgqSOlSm763nSty8PrB3QNb0XETW7es"]],[null,2,[2208,1242],[null,null,"https://play-lh.googleusercontent.com/Vy_YB-b4wRzCnbly4WgZxMD6IvzHSQjaVtMoD9z-lpf12bWLzKPVldvAzcSxhEPd15xR3feoZzCWhenW5uodnQ"]],[null,2,[2208,1242],[null,null,"https://play-lh.googleusercontent.com/F107UPKTof_HQEem0CFXV7Xuyu7D-CD9rRsiTHMKF0A7x85SwYzAUZrmzoH-TNcOXZIRVrwadYPTx3mU8fNF"]],[null,2,[2208,1242],[null,null,"https://play-lh.googleusercontent.com/c4wdkgsMwTaKuOLoypOSe5IXSSOf4MubVwgAkOpwiph6Zne0IdoeWhEMJ7ApVduPA8Vd8tbXY-hoLr7kufF_9g"]],[null,2,[2208,1242],[null,null,"https://play-lh.googleusercontent.com/enbPtk3gI21wxL6GuZ7oLQlcYfptIAa0xDrw9GI0PbFzPqwZv41w7_gaVgqSOlSm763nSty8PrB3QNb0XETW7es"]],[null,2,[2208,1242],[null,null,"https://play-lh.googleusercontent.com/Vy_YB-b4wRzCnbly4WgZxMD6IvzHSQjaVtMoD9z-lpf12bWLzKPVldvAzcSxhEPd15xR3feoZzCWhenW5uodnQ"]]],"Food Recalls \u0026 Alerts",["4.3",4.3097343],"Food \u0026 Drink",null,null,[null,[[0,"USD",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.usfoodrecalls.android\u0026rdid\u003dcom.usfoodrecalls.android\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,"/store/apps/details?id\u003dcom.usfoodrecalls.android"]],["qgKIARqFAQgJShMImozA7Z/plgMVqKWDAx1qqROt+gEPCg0IABIJCgVlbi1VUxAAugRZCh8KGWNvbS51c2Zvb2RyZWNhbGxzLmFuZHJvaWQQARgDGikKIm1jX29ycGhhbl9mb29kX3JlY2FsbHNfMjAyNl8wOF9mY2MQmQEYAyILCgASBzEyNTdiNGM\u003d"],null,[null,"Official Alerts | Outbreaks | Pet Food\u003cbr\u003e\u003cbr\u003eFood-borne illnesses can be devastating worldwide. In the US alone, over 48 million people get sick, 128,000 are hospitalized, and 3,000 die from contaminated food products each year.\u003cbr\u003e\u003cbr\u003eNow you can easily get information on unsafe foods, deadly outbreaks \u0026amp; recall alerts right on your phone so you and your loved ones (including your pets) can stay safe from contaminated foods and food-borne threats.\u003cbr\u003e\u003cbr\u003eTRUSTED BY OVER 250,000 PEOPLE\u003cbr\u003e* Get official food recalls, outbreaks \u0026amp; alerts from trusted sources\u003cbr\u003e\u003cbr\u003eEASY TO UNDERSTAND\u003cbr\u003e* Clear \u0026amp; concise information including product images and map of the affected states\u003cbr\u003e\u003cbr\u003eINCLUDES PET FOOD RECALLS\u003cbr\u003e* Includes pet food recalls for cat and dog owners\u003cbr\u003e\u003cbr\u003eSEARCH AFFECTED PRODUCTS\u003cbr\u003e* Search recalled products and affected stores easily\u003cbr\u003e\u003cbr\u003eREPORT FOOD POISONING INCIDENTS\u003cbr\u003e* Got sick from food poisoning? If so, report such incidents and contaminated foods directly from the app\u003cbr\u003e\u003cbr\u003eUSE THE AI CHATBOT\u003cbr\u003e* Chat with our AI-powered chatbot to get answers to your questions on food safety, recalls, symptoms \u0026amp; more"],"SmartAddress, Inc.","50,000+",null,"",null,null,null,null,[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/9Bl8D8dpZ5k3jx-Sc8ZCryt5PqPZNQMn1AWrF2b15J43GgP6gXLfLexXG5okyJJCTn1_KQ-UTX0AN3qhrdLv5g"],null,[20,169,236,255]],null,["Everyone",[null,2,[512,512],[null,null,"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i"]],null,[null,"In-App Purchases"],[null,"\u003ca href\u003d\"https://support.google.com/googleplay?p\u003dappgame_ratings\"\u003eLearn more\u003c/a\u003e"],0,null,[null,2,[272,272],[null,null,"https://play-lh.googleusercontent.com/OBVqgRK7eerY0GPfK8AOzitu5oE9ecC6kG4kURTCb1K41gpqVsN0WjmJwJh-wX8vILzpcc1kYHt56aLN2g"]],[null,null,null,null,null,[null,null,"https://support.google.com/googleplay?p\u003dappgame_ratings"]]],[[[[[null,[[0,"USD",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.usfoodrecalls.android\u0026rdid\u003dcom.usfoodrecalls.android\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]]],["Install"],null,["CgYKBENBRT0\u003d"]]]],[2],null,[1,1,0],["$3.99 - $99.99 per item",[0]]],[[null,null,null,null,[null,null,"/store/apps/details?id\u003dcom.usfoodrecalls.android"]],["qgKIARqFAQgJShMImozA7Z/plgMVqKWDAx1qqROt+gEPCg0IABIJCgVlbi1VUxAAugRZCh8KGWNvbS51c2Zvb2RyZWNhbGxzLmFuZHJvaWQQARgDGikKIm1jX29ycGhhbl9mb29kX3JlY2FsbHNfMjAyNl8wOF9mY2MQmQEYAyILCgASBzEyNTdiNGM\u003d"],[[null,[[0,"USD",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.usfoodrecalls.android\u0026rdid\u003dcom.usfoodrecalls.android\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]]]],[null,"Stay on top of food recalls"],[null,"Protect your pantry with alerts"],[null,2,[2160,3840],[null,null,"https://play-lh.googleusercontent.com/iqU6NuKWWygpyIhv6XF6qdYOAWsRh8bE3uOPrYjpJZLDIIB1xr5xPGyhoF85yj35ukh8LzOr2hc"],null,[0,65,84,255]],null,"Trending",[null,null,null,null,[null,null,"/store/apps/editorial?id\u003dmc_food_recalls_2026_08_fcp"]],1,null,["Food Recalls \u0026 Alerts"],[[["Food \u0026 Drink",[null,null,null,null,[null,null,"/store/apps/category/FOOD_AND_DRINK"]],"FOOD_AND_DRINK"]]]]],[null,[[["com.aurahealth",7],[null,2,[512,512],[null,null,"https://play-lh.googleusercontent.com/qTs9EIjnI8hR-NAUfeWx28nroEDcRLMoqWc5EdnHHDen_3ctIqAzrTh6YucWJ8pK0Se_89h1Eur0JSiCs9dqow"],null,[252,251,251,255],null,null,null,2],[[null,2,[2688,1242],[null,null,"https://play-lh.googleusercontent.com/4HSyrNtF6G0ANQJBmh_SpLdzVTsNs9AyG7Zdd270sIwvzB1BAh3bxSqpCrZlbdpckU8HyKPsOw9RDb9Kw40mvmQ"]],[null,2,[2688,1242],[null,null,"https://play-lh.googleusercontent.com/FZN_AWNbsoonn5e4n6lI3OF-qB3XFavpNsbAWnV0QPvLvAEW3W397EmSrhycomrGwBLNzY8Kzbjc3dz9D-Ubhw"]],[null,2,[2688,1242],[null,null,"https://play-lh.googleusercontent.com/IA12nklOOJBfLdI0Nsxk6jfbwAoSeNVw26dhr3duYgjPQSt2cqMKzHiewnl3T0ORqi-H5ZPQw82_-QMXWpGxsQ"]],[null,2,[2688,1242],[null,null,"https://play-lh.googleusercontent.com/e3zV2nT4RjS2Yc2mmJWbmKoMYvCx1993TTi-dPkY7pvC1FmJCRnK2QalK1NVQYyoQl6NGDqfq-XIH38m_bjq"]],[null,2,[2688,1242],[null,null,"https://play-lh.googleusercontent.com/WYEDkcfYosgV-5yzexi7j_bpXLlTANc7ipeFqHYhsHbqb0ufArt3LW1cH0Gs4i_0KkjRpU7p8Q4GsYMYeFPQ"]],[null,2,[2688,1242],[null,null,"https://play-lh.googleusercontent.com/X52Xl27c1DDn4OjCcGGMNKze0zySlCOQF9A31xVwfZ-7i0mvR6B5rqfHTGN1SwlKfL8Jt_XJiHeDJfxSk5zQVw"]],[null,2,[2688,1242],[null,null,"https://play-lh.googleusercontent.com/YONz4u6QQ5gz7xo8AB0siQuzG1pbp0FYGC_l3bg0ZmcUsasT-940WlrfcZXKSmck46ZQJyzxSvcSpS0GBs3p4A"]],[null,2,[2688,1242],[null,null,"https://play-lh.googleusercontent.com/hE9WtX5pf72zhC8EK0RCp54MFTYLMd3GWBBxWzgwr8zb7AEWg3zbX0uRWMqTUvTQJtOTOyqVl5uPxPu7fGG079I"]]],"Aura: Meditation \u0026 Sleep, CBT",["4.5",4.5309277],"Health \u0026 Fitness",null,null,[null,[[0,"USD",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.aurahealth\u0026rdid\u003dcom.aurahealth\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,"/store/apps/details?id\u003dcom.aurahealth"]],["qgJ7GnkICkoTCJqMwO2f6ZYDFailgwMdaqkTrfoBDwoNCAASCQoFZW4tVVMQALoETQoUCg5jb20uYXVyYWhlYWx0aBABGAMaKAohbWNfb3JwaGFuX2F1cmFtYXh4aW5nXzIwMjZfMDhfZmNjEJkBGAMiCwoAEgcxMjdjYWM0"],null,[null,"Aura: Meditation \u0026amp; Sleep, CBT is a premier meditation and self-help app for better sleep, stress relief and self-improvement. It provides personalized guided meditations, mindfulness life coaching, CBT (Cognitive Behavioral Therapy), breathwork, soothing sleep sounds, sleep stories and much more.\u003cbr\u003e \u003cbr\u003eAura is an all-in-one app that offers daily meditations, CBT, hypnosis on subjects like better sleep, stress, anxiety, depression, insomnia, motivation and more topics for any situation. Learn mindfulness, choose guided meditations and take breathing exercises led by top coaches.\u003cbr\u003e \u003cbr\u003e** Featured on: The New York Times, Forbes, The Oprah Magazine, Women’s \u0026amp; Men’s Health, and more.**\u003cbr\u003e \u003cbr\u003eWith a global community of 7 million users, a 98% user satisfaction rate, and advanced personalization, the Aura mobile app is the trusted choice for daily mental health, motivation, self-help, and self-care, all achievable in just 3 minutes a day.\u003cbr\u003e \u003cbr\u003e\u003cb\u003eWHAT YOU GET WHEN YOU DOWNLOAD\u003c/b\u003e\u003cbr\u003e \u003cbr\u003e\u003cb\u003eEXTENSIVE CONTENT LIBRARY:\u003c/b\u003e\u003cbr\u003eAccess to the world\u0026#39;s largest premium wellness library. The content is divided into categories such as meditation, sleep, anxiety, breathwork, ASMR, affirmations, happiness, and more.\u003cbr\u003eThere is a large collection of self-care relaxing sounds: rain sounds, soothing sleep sounds, nature sounds, white noise, calming sea, and more.\u003cbr\u003e\u003cbr\u003e\u003cb\u003eEXPERT GUIDANCE: \u003c/b\u003e\u003cbr\u003eContent led by top motivational, mindfulness and insomnia coaches, therapists, and storytellers from around the world. Receive effective self-help \u0026amp; motivational guidance from daily meditations to cognitive behavioral therapies (CBT). Enjoy live sessions or schedule your activities at your preferred time.\u003cbr\u003e \u003cbr\u003e\u003cb\u003eBETTER SLEEP:\u003c/b\u003e\u003cbr\u003eMeditations for sleep, sleep sounds \u0026amp; stories, cognitive behavioral therapies for insomnia (CBT-I) and relaxing sounds to promote restful \u0026amp; better sleep.\u003cbr\u003e \u003cbr\u003e\u003cb\u003eBREATHWORK:\u003c/b\u003e\u003cbr\u003eTake breathing exercises with a coach at a guided session or take one of our offline breathwork courses.\u003cbr\u003e \u003cbr\u003ePROGRAMS:\u003cbr\u003eExplore subjects deeply and effectively with the following pre-designed programs:\u003cbr\u003e - Sleep Meditation,\u003cbr\u003e- Calm Anxiety,\u003cbr\u003e- Stress Relief,\u003cbr\u003e- Hypnosis for Sleep,\u003cbr\u003e- Intro to Cognitive Behavioral Therapy (CBT).\u003cbr\u003e- Cognitive Behavioral Therapies for Insomnia (CBT-I), and more.\u003cbr\u003e \u003cbr\u003e\u003cb\u003eGRATITUDE JOURNAL:\u003c/b\u003e\u003cbr\u003eA tool for self-help, self-reflection and gratitude, which can have a positive impact on your mental health. Manage stress, anxiety, and depression by focusing on positive aspects and self-care of your life.\u003cbr\u003e \u003cbr\u003e\u003cb\u003eMOOD TRACKER:\u003c/b\u003e\u003cbr\u003eA feature to help you become more aware of your moods and emotions, allowing you to visualize your progress over time.\u003cbr\u003e \u003cbr\u003e\u003cb\u003eWHY MILLIONS OF PEOPLE USE AURA? \u003c/b\u003e\u003cbr\u003e \u003cbr\u003e\u003cb\u003eDaily Wellness Habit:\u003c/b\u003e An easy-to-follow, daily self-help routine that takes just 3 minutes a day to help you relax, become more mindful and motivational, and enhance your mental health with Aura: Meditation \u0026amp; Sleep, CBT.\u003cbr\u003e \u003cbr\u003e\u003cb\u003eStress and Anxiety Relief:\u003c/b\u003e On-demand resources to reduce stress and anxiety, providing guided meditations, relaxing sounds, life coaching to find positivity and calm.\u003cbr\u003e \u003cbr\u003e\u003cb\u003ePersonalization: \u003c/b\u003e Aura has the world\u0026#39;s most advanced personalization engine powered by the latest research in machine learning. It offers highly personalized content and recommendations to each user\u0026#39;s specific needs and preferences, making it a valuable and relevant resource to improve your mental health.\u003cbr\u003e \u003cbr\u003e\u003cb\u003eСonstantly Updated Content: \u003c/b\u003e With a vast library of content spanning guided meditations, life coaching, CBT, and more.\u003cbr\u003e \u003cbr\u003e\u003cb\u003eSupportive Community: \u003c/b\u003e Join a passionate community of 7 million users worldwide who love Aura and benefit from its offerings.\u003cbr\u003e \u003cbr\u003eDownload Aura: Meditation \u0026amp; Sleep, CBT and get access to a world of personalized mental wellness resources, including guided meditations, life coaching, and CBT.\u003cbr\u003e\u003cbr\u003ePrivacy Policy: http://www.aurahealth.io/privacy-policy"],"Aura Health - Mindfulness, Sleep, Meditations","1,000,000+",null,"",null,null,null,null,[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/0KnwFMCXVoPcvySdUFH5RzXtu4tUCAlP8IUPn68546PX6LRSzw7amFTFHYTQ3ABDeUruZIA7iIa1vH5BxLhyZQ"],null,[28,38,48,255]],null,["Everyone",[null,2,[512,512],[null,null,"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i"]],null,[null,"Users Interact, Shares Info, Digital Purchases"],[null,"\u003ca href\u003d\"https://support.google.com/googleplay?p\u003dappgame_ratings\"\u003eLearn more\u003c/a\u003e"],0,null,[null,2,[272,272],[null,null,"https://play-lh.googleusercontent.com/OBVqgRK7eerY0GPfK8AOzitu5oE9ecC6kG4kURTCb1K41gpqVsN0WjmJwJh-wX8vILzpcc1kYHt56aLN2g"]],[null,null,null,null,null,[null,null,"https://support.google.com/googleplay?p\u003dappgame_ratings"]]],[[[[[null,[[0,"USD",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.aurahealth\u0026rdid\u003dcom.aurahealth\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u0