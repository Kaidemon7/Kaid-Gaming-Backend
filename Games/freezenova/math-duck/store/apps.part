ozA7Z/plgMVqKWDAx1qqROtsgRVClEKFwoRY29tLm5pbnRlbmRvLnpuc2EQARgDEhkKEzQ4MzIzMjY0MDY0OTQyMzM2NTMQURgDGAMgAiiA2vCsiDQwgPq4rpE0QAFIAVoCCAGAAQIwCA\u003d\u003d"],null,[null,"Nintendo Today! is an app that brings you daily updates from Nintendo based on what you like.\u003cbr\u003e\u003cbr\u003e◆ Animated Calendar\u003cbr\u003eKeep track of the date with an animated calendar featuring your choice of characters.\u003cbr\u003e\u003cbr\u003e◆ Daily Updates\u003cbr\u003eGet updates on all things Nintendo—including Nintendo Switch 2 news, game info, videos, comics, and more—every day.\u003cbr\u003e\u003cbr\u003e◆ Event Schedule\u003cbr\u003eKeep up with Nintendo related events, including game releases. Link with the Google Calendar app to display your own events as well.\u003cbr\u003e\u003cbr\u003e◆ Customize Your Home Screen\u003cbr\u003eAdd a calendar widget featuring art from your favorite Nintendo game series.\u003cbr\u003e\u003cbr\u003e[Terms of Use]\u003cbr\u003eNintendo Account and persistent internet connection required. Data charges may apply.\u003cbr\u003eRequires Android 10.0 or later.\u003cbr\u003e\u003cbr\u003eNintendo Account Agreement\u003cbr\u003ehttps://accounts.nintendo.com/term_chooser/eula\u003cbr\u003e\u003cbr\u003e© Nintendo\u003cbr\u003eMay include advertising."],"Nintendo Co., Ltd.","1,000,000+",null,"",null,null,null,null,[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/fQhEB66SyasXd8lzrqsyHWCF8AkPuQW_YGCBsP4dxIuwxnSshYUgwPUSQcYwuEI9bWZQS7UXt-wBSgYSYBx_"],null,[229,10,18,255]],null,["Teen",[null,2,[512,512],[null,null,"https://play-lh.googleusercontent.com/mw_NfsvKM8m6RPv8Fz2GQawCOsqWv010saMnc7zbWalMxuaA9IY8h7E0VMieLxSxAFB98NFeYqbFrXXq"]],[null,"Diverse Content: Discretion Advised"],null,[null,"\u003ca href\u003d\"https://support.google.com/googleplay?p\u003dappgame_ratings\"\u003eLearn more\u003c/a\u003e"],0,null,[null,2,[272,272],[null,null,"https://play-lh.googleusercontent.com/xl04GurQer374yogi24hRkvUcXtMStMOcOo86Sprmrid9j6wQHF0d