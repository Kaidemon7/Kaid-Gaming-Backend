/1VmwcTXf0GBW-C8YMQINxI-MQWdIAlhXWkCVQ1lLZTIPWyg-UkB5IY1uL_GKV5uRGj6_9L_hGQoYpNyL5LlHZ0Q"]],[null,2,[1200,1920],[null,null,"https://play-lh.googleusercontent.com/SD_-f6dD_25UzJR2jMt0UIdS_5zR7WhfgQkBhaCIJtOKawDRSDPwiFuC-a3Y1nuuLYcZNxjAX1xCvFymW0mH"]],[null,2,[1200,1920],[null,null,"https://play-lh.googleusercontent.com/Jwo79XuvKiaxi1REExf1Ri4Q-MbdqDXRlVrozlVFHqBfvcwG6NMZ0czhYOlAL6dhQumSy5KTcI8uTBWgvDQZ"]],[null,2,[1200,1920],[null,null,"https://play-lh.googleusercontent.com/jW7cmfqP7eXCiTonmggb5SFGlivIjwRZXKoT8so8716JNxcRhIOwzw6JYt6KyLJnTZ7S2dx72IAjz7zmw17FBoo"]],[null,2,[1200,1920],[null,null,"https://play-lh.googleusercontent.com/JbijZAYFs6GyaK-LOzgR38VJs2Jhkcn8lcHew1kSrc8r1QWEjVYVgBOZGaOnjfHWJ_QOLBiKsB0H_2R4_rw7"]]],"ibis Paint X",["4.4",4.4270353],"Art \u0026 Design",null,null,[null,[[0,"USD",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003djp.ne.ibis.ibispaintx.app\u0026rdid\u003djp.ne.ibis.ibispaintx.app\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,"/store/apps/details?id\u003djp.ne.ibis.ibispaintx.app"]],["qgJkGmIIEhIhCh8KGWpwLm5lLmliaXMuaWJpc3BhaW50eC5hcHAQARgDShMImozA7Z/plgMVqKWDAx1qqROtmgETCJivybz56JYDFYaigwMdNY4iNvoBDwoNCAASCQoFZW4tVVMQAA\u003d\u003d"],[[[null,null,"pI-ohnCFi5c",[null,null,"https://play.google.com/video/lava/web/player/yt:movie:pI-ohnCFi5c?autoplay\u003d1\u0026embed\u003dplay"],"yt:movie:pI-ohnCFi5c",null,[1920,1080],null,null,"AXH1eznvu6ZArjBEYhBNisTvxh-N-4NVzZ87fhumfmBtkjKbX5GbdSCPi6ASO0JQfP9hHgW2D-Kn4DQzCopCAH0KbsHVMJai4qeJ1lkyUyNEhQ5N-S8ufUrOUSasmbTY9-wILsYS74sSz2z2nnbfLs8zts73tU2s27yBfl1U9_5YjeCLOVgAu4i-Ept2hDqyaVNRJGKI4QwFOIpGg8aPS9mxMXmlsFUnSALo2yefGymg7vyqVroCjTeeHzKsZ8bsJfW-vFtqD2wYYs9eBJh4f2UDqqO38jxuE5A0acOWpkHzzg\u003d\u003d"],null,1,[null,null,null,[null,null,"https://i.ytimg.com/vi/pI-ohnCFi5c/hqdefault.jpg"]]]],[null,"For everyone around the world who wants to draw and animate, freely and without pressure.\u003cbr\u003e\u003cbr\u003eibisPaint X is a full-featured illustration and animation app for smartphones and tablets, with over 500 million cumulative downloads across the series.\u003cbr\u003e\u003cbr\u003e\u0026quot;Drawing looks hard\u0026quot; — this app is made especially for people who think that. A creative experience that doesn\u0026#39;t compromise even for free, an interface simple enough to use without hesitation, and a comfortable familiarity that grows the more you use it. ibisPaint X keeps serving as an easy entry point for anyone to start \u0026quot;drawing,\u0026quot; while continually expanding what\u0026#39;s possible — from a single illustration to frame-by-frame animation, and on to videos with background music and audio.\u003cbr\u003e\u003cbr\u003eWith over 130,000 brushes, 30,000+ materials, 3,000+ fonts, 86 image filters, 46 screentones, 27 layer blending modes, vector tools, a reference window, radial and symmetry rulers, animated filters, and an AI Disturbance feature, ibisPaint X packs in serious functionality that rivals PC illustration software. It\u0026#39;s a one-stop app that goes beyond drawing illustrations — into animation production, and even recording and sharing your creative process as a time-lapse video. It\u0026#39;s chosen by people of all ages, countries, and experience levels around the world.\u003cbr\u003e\u003cbr\u003e*Drawing Tutorial YouTube Channel\u003cbr\u003eWe post lots of videos on how to make the most of ibisPaint. Please subscribe!\u003cbr\u003ehttps://youtube.com/ibisPaint\u003cbr\u003e\u003cbr\u003e*Supported Digital Styluses\u003cbr\u003ehttps://ibispaint.com/stylus/supported_digital_stylus.jsp?platformType\u003d2\u003cbr\u003e\u003cbr\u003e*About Purchase Plans\u003cbr\u003ehttps://ibispaint.com/lecture/index.jsp?no\u003d26\u003cbr\u003e* If you do not cancel auto-renewal at least 24 hours before the free trial ends, you will be automatically charged upon renewal.\u003cbr\u003e\u003cbr\u003e*About App Access Permissions\u003cbr\u003eThis app may access various device features to provide the service and improve usability. No access permission is required to use this app — all of the following are optional. You may decline any of these optional permissions. Even if declined, the app\u0026#39;s core features remain available, but some features that require the relevant permission may be limited.\u003cbr\u003e\u003cbr\u003e•Photos/videos in your photo library\u003cbr\u003e To import artwork files and images, and to save the artwork files, images, and videos you create\u003cbr\u003e\u003cbr\u003e•Microphone audio input\u003cbr\u003e To connect and communicate with supported peripherals such as digital styluses\u003cbr\u003e\u003cbr\u003e•Push notifications\u003cbr\u003e To deliver notifications related to your artwork, app update information, and important announcements\u003cbr\u003e\u003cbr\u003e*Questions \u0026amp; Bug Reports\u003cbr\u003eWe\u0026#39;re unable to respond to questions or bug reports left in reviews. Please contact our support desk below instead.\u003cbr\u003ehttps://ssl.ibis.ne.jp/en/support/Entry?svid\u003d25\u003cbr\u003e\u003cbr\u003e*ibisPaint Terms of Service\u003cbr\u003ehttps://ibispaint.com/agreement.jsp"],"ibis inc.","100,000,000+",null,"",null,null,null,null,[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/M09MoKPWxNQGnyTz3arUsw9PpKU7-FkCYrtcqt_3TUvvMLY6fCW9eKikCL4wvKHPS1BatT4zMmSPdRwf3Sf3"],null,[65,83,105,255]],null,["Everyone",[null,2,[512,512],[null,null,"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i"]],null,[null,"Users Interact"],[null,"\u003ca href\u003d\"https://support.google.com/googleplay?p\u003dappgame_ratings\"\u003eLearn more\u003c/a\u003e"],0,null,[null,2,[272,272],[null,null,"https://play-lh.googleusercontent.com/OBVqgRK7eerY0GPfK8AOzitu5oE9ecC6kG4kURTCb1K41gpqVsN0WjmJwJh-wX8vILzpcc1kYHt56aLN2g"]],[null,null,null,null,null,[null,null,"https://support.google.com/googleplay?p\u003dappgame_ratings"]]],[[[[[null,[[0,"USD",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003djp.ne.ibis.ibispaintx.app\u0026rdid\u003djp.ne.ibis.ibispaintx.app\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]]],["Install"],null,["CgYKBENBRT0\u003d"]]]],[2],null,[1,1,0],["$2.99 - $79.99 per item",[0]]],[["com.scaleup.chatai",7],[null,2,[512,512],[null,null,"https://play-lh.googleusercontent.com/NOnNjxyGYX25Nopwpy-7xw624waRMSv5JyKI_VLj69M_Exa6GhxBZEhSVyNI3nbFCw7ebOWeJk_vMHYbbna7QQ"],null,[0,0,0,255],null,null,null,2],[[null,2,[2796,1290],[null,null,"https://play-lh.googleusercontent.com/0vMsGn4tYlH4UAFQY68bFrbAkGOUMuhZ1iJ-EUTZLYHNzQZN7R058RbUbghAEem5kOLEZtiivSkZBSFJkh9CFg"]],[null,2,[2796,1290],[null,null,"https://play-lh.googleusercontent.com/bVoYDP-GzYUiNJxx11YRb0JMQ2jY3eUutr7-ncIKfDyMVvGg_OGgKlJsz-1iU6MvIJTSVH0EY9ACGug_s-iBkA"]],[null,2,[2796,1290],[null,null,"https://play-lh.googleusercontent.com/rx50ljd9cNPNBoocEMBAd9jpJiD-x0AbAgbcAIozuKNh8vhDJZkXITHBqwb_vSuLeuZCO64VrgdKargjqS1w"]],[null,2,[2796,1290],[null,null,"https://play-lh.googleusercontent.com/RW8CLaFNgmKr4-MRcwK-Hb89tXValD434Zcc4txrP5qrbPlARf07XapdYP0imExcfWXf_YuTUsRx--j7mgkbMQ"]],[null,2,[2796,1290],[null,null,"https://play-lh.googleusercontent.com/3Kr6viOWEvnmenWFixIad3nEm415UApbCuzWI-5-OqLHlWAAW2s2s5VKZaPBiDLQaRxBBRjOUZt8n9tkJMGb"]],[null,2,[2796,1290],[null,null,"https://play-lh.googleusercontent.com/z10ukhqPfrjrAHN6gcrvQ9MflrVGsIaEr12WvNmdWRHEtQxnxulSZx8vnz7XtgfeVYi2UPRjaNqiueG6F53DcA"]],[null,2,[2796,1290],[null,null,"https://play-lh.googleusercontent.com/Dk9UpB5sYI0CTwZgOT1l23EcPIeKIhY5CD47cq2hkzg2am55vZ-RMVtTUQacpj-P-mb91jT_UwlP7U2YZoY"]],[null,2,[2796,1290],[null,null,"https://play-lh.googleusercontent.com/qNkE7R-pFKS4mCh3ojNE0u2j3D0WNf09UCGBImn4m5AywUjwGqHVuRi_tbN5DwzYEQOl4Ci3iAmsvxNZKa7cCg"]],[null,2,[2732,20