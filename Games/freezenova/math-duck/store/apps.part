null,null,null,null,[null,null,"/store/apps/details?id\u003dcom.bite.chillchat"]],["qgJdGlsIDBIaChgKEmNvbS5iaXRlLmNoaWxsY2hhdBABGANKEwiajMDtn+mWAxWopYMDHWqpE62aARMImK/JvPnolgMVhqKDAx01jiI2+gEPCg0IABIJCgVlbi1VUxAA"],null,[null,"ChillChat is a LIVE social community where games and good times connect. Jump into voice rooms, challenge players in fun party games, and just chill. ChillChat is a fun place for you to share your skills and hang out with a great community.\u003cbr\u003e\u003cbr\u003eFeatures:\u003cbr\u003e🎮 Gaming \u0026amp; Party Rooms:\u003cbr\u003e- Have fun in group party rooms and play a variety of games with others. Join the excitement and connect with fellow gaming enthusiasts!\u003cbr\u003e\u003cbr\u003e🤳🏻 Live Streaming:\u003cbr\u003e- Go live to share your gameplay, your talents, or just hang out with your followers. Start your wonderful journey now!\u003cbr\u003e\u003cbr\u003e🎁 Gifts:\u003cbr\u003e- Discover various gift themes and send cool surprises to your favorite creators and players!\u003cbr\u003e\u003cbr\u003eDownload ChillChat now and join the fun!"],"Mangostar Team","5,000,000+",null,"",null,null,null,null,[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/RFatnVuLZTgHyyaHkWtk4T92ZRjK3EJ8CrilIVCb4SD1nRtIBxlokmMGT8UuibbmZABdZBGubIlj6IKg_0wSpA"],null,[162,146,254,255]],null,["Mature 17+",[null,2,[512,512],[null,null,"https://play-lh.googleusercontent.com/YX4IU7qLML-be7Xl25J-YkRBNgSZhVhJIsxeLdke3SaX1QBSFEKLbdcWORAwahq0oI4rrjz5YnWiVdb5"]],null,[null,"Users Interact, In-App Purchases"],[null,"\u003ca href\u003d\"https://support.google.com/googleplay?p\u003dappgame_ratings\"\u003eLearn more\u003c/a\u003e"],0,null,[null,2,[272,272],[null,null,"https://play-lh.googleusercontent.com/8TmeYqtEq_9kcV2_pw_YXR9bvGw0PJI_H67wFyWIKepZ2vzD0nib786iY3ypWcbVxxRqmeaMObMh-sMf"]],[null,null,null,null,null,[null,null,"https://support.google.com/googleplay?p\u003dappgame_ratings"]]],[[[[[null,[[0,"USD",""]],null,[null,"Buy"],null,1,[null,null,null