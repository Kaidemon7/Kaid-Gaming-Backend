tps://play-lh.googleusercontent.com/zi7Ry2aILHfxlCWoM6k-HheS7RckdKc3b6xT6CNgkzoHqnqUrqKKHo2YhLzslSSRK_zmxYhLQO9aLLi20hFZHTQ"]],[null,2,[2732,2048],[null,null,"https://play-lh.googleusercontent.com/euXGKkok3grHDTYZbCnb_TaRyR-OV_cJiOEFsJGM8jbh3fp5DWPHO97DF1Wi9uXHvPoOvzXMfSAS57mGDGqX"]],[null,2,[2160,2800],[null,null,"https://play-lh.googleusercontent.com/C1ed9OGD87CSppc4RIWRaa6GnIPkmEmyDbncBHTPOwAXHDLhKbmYR5WDa0hs1of-kDTHsREO-DidpUj9PQwP-w"]],[null,2,[2732,2048],[null,null,"https://play-lh.googleusercontent.com/mzEwwqT33JBW9EJEgSrdQoa0lXv04y5wSnHI_0-VSDl3UXfdNelXOSM2HFqf7h4ZDQgwuoCua1InNv5ceXc6"]],[null,2,[2732,2048],[null,null,"https://play-lh.googleusercontent.com/mLJE7NmTIeJNAZN02bSjpD5W0O9R_NQHjDYRxx80ERNDcAeQ3KCbG6FdPfeEyzQfwIdLxaZDRy0ARL61jG9VpTE"]],[null,2,[2732,2048],[null,null,"https://play-lh.googleusercontent.com/JOocE6Ub0XjQmgt4yALMHueFWZ_Fjo_mP4mUe68b-HmbdAOXrr-LzdhXwLABcZzSBKOe_ASOMb8YAYr2qRpn4g"]],[null,2,[2732,2048],[null,null,"https://play-lh.googleusercontent.com/fMapR3iBa_Q2CIIt_srOExgmExk6AGiNdibfqL9b6ObNuwDKetLjYXpBhjxoRy1_Q49O_F2Oa40ulhslYwQn"]],[null,2,[2732,2048],[null,null,"https://play-lh.googleusercontent.com/zi7Ry2aILHfxlCWoM6k-HheS7RckdKc3b6xT6CNgkzoHqnqUrqKKHo2YhLzslSSRK_zmxYhLQO9aLLi20hFZHTQ"]],[null,2,[2732,2048],[null,null,"https://play-lh.googleusercontent.com/euXGKkok3grHDTYZbCnb_TaRyR-OV_cJiOEFsJGM8jbh3fp5DWPHO97DF1Wi9uXHvPoOvzXMfSAS57mGDGqX"]],[null,2,[2732,2048],[null,null,"https://play-lh.googleusercontent.com/JrIJ_VDR0WfanqBNDGQG_bPriAt0g9MX6ZUyMn3jXex0vDkTPrWDh0b9q5deXts9Cl53STXcHImlpF2hN7_g"]]],"Lightroom Photo \u0026 Video Editor",["4.5",4.4754643],"Photography",null,null,[null,[[0,"USD",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.adobe.lrmobile\u0026rdid\u003dcom.adobe.lrmobile\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,"/store/apps/details?id\u003dcom.adobe.lrmobile"]],["qgKhARqeAQgDShMImozA7Z/plgMVqKWDAx1qqROt+gEXChUIw77b3dqLkYpDEgkKBWVuLVVTEAC6BGoKGAoSY29tLmFkb2JlLmxybW9iaWxlEAEYAxpCCjttY19vcnBoYW5fYXBwc19haV9nYXRld2F5X2xpZ2h0cm9vbV9waG90b192aWRlb19lZGl0b3JfcmZjYxCZARgDIgoKABIGZGIyMDU5"],null,[null,"Ever wish your photos could really show what makes a moment special? Adobe Lightroom is a free photo and video editor that helps you do just that. From your dog’s goofy grin to that sunset that took your breath away, Adobe Lightroom makes it simple to bring those moments to life, just the way you see them.\u003cbr\u003e\u003cbr\u003eWhether you’re snapping pics on the go or curating your social feed, Lightroom puts powerful AI photo tools in your pocket to make quick edits easy and fun. The Adobe Lightroom photo editor app is here to help you create photos you’re proud to share.\u003cbr\u003e\u003cbr\u003eAI PHOTO EDITOR \u0026amp; NEW FILM FILTER PRESETS THAT SET YOUR PICTURE APART\u003cbr\u003eWant brighter colors? Softer, blurry backgrounds? A quick touch-up to crop and resize a photo? Adobe Lightroom’s one-tap features like Quick Actions and Adaptive Presets let you enhance photo quality in seconds. Try our new film filter presets to match your vintage aesthetic. Our AI photo editor tools suggest the best edits for your images. Perfect for quick fixes or adding a unique vibe, no experience required. Use it as your go-to picture editor.\u003cbr\u003e\u003cbr\u003eEDIT PHOTOS, REMOVE DISTRACTIONS, \u0026amp; BLUR BACKGROUND\u003cbr\u003eAdobe Lightroom photo editor gives you access to tools that feel professional but stay approachable. Blur the photo background for a polished look, adjust the finer details, or use Generative Remove as an AI photo editor to erase objects within your photos.\u003cbr\u003e\u003cbr\u003ePOWERFUL EDITS WITH ZERO HASSLE\u003cbr\u003eEdit photos easily by tweaking exposure, highlights, and shadows. Fix photos with new film filter presets, unique photo effects, color grading, hue, saturation, or add a blurry bokeh effect to nail the perfect vibe. Edit photos with your creative control while keeping it simple.\u003cbr\u003e\u003cbr\u003eGET INSPIRATION FROM THE COMMUNITY\u003cbr\u003eNot sure where to start? Browse photo presets shared by creators around the world. From vintage film filter photo effects to applying a retro photo filter, Adobe Lightroom has the presets to match your aesthetic. Whether you’re looking to make bold edits with AI photo editor tools or subtle tweaks for polished portrait edits, find a look that matches your style — or create your own. Save your favorites and make every photo feel like you.\u003cbr\u003e\u003cbr\u003eEDIT ONCE, APPLY EVERYWHERE\u003cbr\u003eSnapped a whole concert, travel day, or family gathering? Use Lightroom’s AI photo editor tools to fix photos in batches to keep your photo edits looking consistent.\u003cbr\u003e\u003cbr\u003eWHY ADOBE LIGHTROOM?\u003cbr\u003e• Edit photos for every moment: whether editing photos for fun, capturing memories, gaining confidence, or sharing on social media.\u003cbr\u003e• Flexible picture editor: Our photo editor is beginner-friendly and grows with you to strengthen your editing skills. Fix photos, crop and resize images, blur background elements, or remove distractions.\u003cbr\u003e• User-friendly AI photo editor designed to help build confidence, spark creativity, and showcase your authentic style.\u003cbr\u003e\u003cbr\u003ePICTURE EDITOR TOOLS YOU\u0026#39;LL LOVE\u003cbr\u003e• Quick Action photo editor: Fix photos with suggested edits tailored to your pics.\u003cbr\u003e• Preset Edits: Discover filters or make your own signature look. Try our NEW film filter presets to match your cinematic style.\u003cbr\u003e• Background Blur: Create depth with a blurry background effortlessly.\u003cbr\u003e• Generative Remove Edits: Take out the things you didn’t want with this AI photo eraser.\u003cbr\u003e• Video Editing: Bring the same creative energy to your clips with tools for light, color, and presets.\u003cbr\u003e\u003cbr\u003eFOR EVERY KIND OF PHOTOGRAPHER\u003cbr\u003ePhoto editing has never been easier. Lightroom is here to empower you - to capture sunsets, family moments, or your latest foodie find. With tools to fix pictures, enhance photo quality, and edit videos, Adobe Lightroom gives you the right balance of ease and control.\u003cbr\u003e\u003cbr\u003eDownload Adobe Lightroom today.\u003cbr\u003e\u003cbr\u003eTerms \u0026amp; Conditions:\u003cbr\u003eYour use of this application is governed by the Adobe General Terms of Use http://www.adobe.com/go/terms_en and the Adobe Privacy Policy http://www.adobe.com/go/privacy_policy_en\u003cbr\u003e\u003cbr\u003eDo not sell or share my personal information www.adobe.com/go/ca-rights"],"Adobe","100,000,000+",null,"",null,null,null,null,[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/Zp2vYVG_DCGSUJPHJdkwh5wcgpQ2CKrKUW0tboBagKLyBlupHgJVu6flSeIHojKQQW53OFzEoXl_mNZqF8Ty22Q"],null,[229,230,231,255]],null,["Everyone",[null,2,[512,512],[null,null,"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i"]],null,[null,"Users Interact"],[null,"\u003ca href\u003d\"https://support.google.com/googleplay?p\u003dappgame_ratings\"\u003eLearn more\u003c/a\u003e"],0,null,[null,2,[272,272],[null,null,"https://play-lh.googleusercontent.com/OBVqgRK7eerY0GPfK8AOzitu5oE9ecC6kG4kURTCb1K41gpqVsN0WjmJwJh-wX8vILzpcc1kYHt56aLN2g"]],[null,null,null,null,null,[null,null,"https://support.google.com/googleplay?p\u003dappgame_ratings"]]],[[[[[null,[[0,"USD",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.adobe.lrmobile\u0026rdid\u003dcom.adobe.lrmobile\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]]],["Install"],null,["CgYKBENBRT0\u003d"]]]],[2],null,[1,1,0],["$0.49 - $499.99 per item",[0]]],[[null,null,null,null,[null,nul