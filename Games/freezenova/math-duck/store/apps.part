lh.googleusercontent.com/kMn8YiXhePrvYkCiwiu046dDzVSue6R6VGMetC5vZcsrvxpizWXadeZ3JwlLYfrm_BDiEuj88TmsVboR4X9aSg"]],[null,2,[1920,1080],[null,null,"https://play-lh.googleusercontent.com/e28Lg7RVHUAshlsAvnpltTBgoBKga-tkU7rfc8MKUsMnFO8RqO8Lkwl_9gDQR5jF4I7TtXol3So14RhW1lYB1w"]]],"MBC Shahid",["3.2",3.2192135],"Entertainment",null,null,[null,[[0,"USD",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dnet.mbc.shahid\u0026rdid\u003dnet.mbc.shahid\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,"/store/apps/details?id\u003dnet.mbc.shahid"]],["qgJZGlcIEBIWChQKDm5ldC5tYmMuc2hhaGlkEAEYA0oTCJqMwO2f6ZYDFailgwMdaqkTrZoBEwiYr8m8+eiWAxWGooMDHTWOIjb6AQ8KDQgAEgkKBWVuLUdCEAA\u003d"],null,[null,"Welcome to MBC Shahid – Your Ultimate Entertainment Destination\u003cbr\u003eDive into a refreshed world of endless entertainment with MBC Shahid—now with a brand-new look and enhanced experience. Discover the leading platform for Arabic Originals, exclusive series, blockbuster movies, live TV, sports, and more. Whether you’re watching for free or subscribing, enjoy unlimited access to premium content tailored just for you.\u003cbr\u003eWhy Choose MBC Shahid?\u003cbr\u003e1. Exclusive Arabic Originals\u003cbr\u003eEnjoy the finest Arabic Original productions available exclusively on MBC Shahid. From gripping dramas to captivating comedies, we bring you stories that resonate with your heart.\u003cbr\u003e2. Live Sports in HD\u003cbr\u003eCatch the thrill of local and international sports and tournaments, all in stunning HD (available in MENA only).\u003cbr\u003e3. Unmissable Live Events\u003cbr\u003eStay entertained with iconic events like Riyadh Season, Jeddah Season, live concerts, and theatrical plays.\u003cbr\u003e4. Ad-Free Streaming\u003cbr\u003eEnjoy uninterrupted, non-stop entertainment when you subscribe. Say goodbye to ads and hello to seamless viewing.\u003cbr\u003e5. Live TV Channels\u003cbr\u003eWatch your favorite channels in crystal-clear Full HD and stay on top of the latest news, entertainment, and more.\u003cbr\u003e6. Exclusive Movie \u0026amp; Series Premieres\u003cbr\u003eBe the first to watch the latest series and movies before they hit TV or cinemas.\u003cbr\u003e7. A World of Genres\u003cbr\u003eFrom heart-pounding horror and thrilling dramas to laugh-out-loud comedies and enchanting romance, MBC Shahid’s vast library has something for everyone. Explore Egyptian classics, Turkish sensations, and captivating foreign series at your fingertips.\u003cbr\u003e8. Family-Friendly Content\u003cbr\u003eSecure profiles and exclusive kids’ content ensure entertainment for all ages in a safe and dedicated environment.\u003cbr\u003eFeatures You’ll Love\u003cbr\u003e•\tCreate Personalized Profiles: Assign unique profiles to each family member for a tailored viewing experience.\u003cbr\u003e•\tBuild Your Watchlist: Save your favorite shows and movies for easy access anytime.\u003cbr\u003e•\tDownload \u0026amp; Watch Offline: Take your entertainment on the go by downloading content to watch without an internet connection.\u003cbr\u003eWhy MBC Shahid is Perfect for You\u003cbr\u003e•\tA constantly updated media library keeps you up-to-date with the latest blockbusters and trending series.\u003cbr\u003e•\tInstant access to a global selection of TV favorites, tailored for you.\u003cbr\u003e•\tEffortlessly browse curated categories for every mood and preference.\u003cbr\u003e•\tPersonalized recommendations and updates so you never miss a thing.\u003cbr\u003eDownload the MBC Shahid app now and explore our unlimited benefits and perks. Immerse yourself in a world of award-winning movies, trending series, and captivating live events—all in ultimate quality and comfort. Once you start, you’ll be hooked.\u003cbr\u003eEnjoy access to the best movies, series, and live entertainment awaits—don’t miss out!\u003cbr\u003e\u003cbr\u003ePrivacy Policy: https://www.mbc.net/en/privacy-policy\u003cbr\u003eTerms of Use: https://shahid.mbc.net/ar/terms-and-conditions"],"MBC Group","100,000,000+",null,"",null,null,null,null,[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/z2ls5q2O6fmLQQTwoJAD8r00MGjQiN6Hwt48J97pNNvwwjX-wNLELNvwCDJEIie_GA3CIgODMF7_NADAxp9nEQ"],null,[23,13,47,255]],null,["Teen",[null,2,[512,512],[null,null,"https://play-lh.googleusercontent.com/mw_NfsvKM8m6RPv8Fz2GQawCOsqWv010saMnc7zbWalMxuaA9IY8h7E0VMieLxSxAFB98NFeYqbFrXXq"]],null,[null,"Digital Purchases"],[null,"\u003ca href\u003d\"https://support.google.com/googleplay?p\u003dappgame_ratings\"\u003eLearn more\u003c/a\u003e"],0,null,[null,2,[272,272],[null,null,"https://play-lh.googleusercontent.com/xl04GurQer374yogi24hRkvUcXtMStMOcOo86Sprmrid9j6wQHF0d9xMh73CwUEg57lbsGIwpOXgrJ927Q"]],[null,null,null,null,null,[null,null,"https://support.google.com/googleplay?p\u003dappgame_ratings"]]],[[[[[null,[[0,"USD",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dnet.mbc.shahid\u0026rdid\u003dnet.mbc.shahid\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]]],["Install"],null,["CgYKBENBRT0\u003d"]]]],[2],null,[1,1,0],["$0.99 - $304.99 per item",[0]]],[["org.mozilla.firefox",7],[null,2,[512,512],[null,null,"https://play-lh.googleusercontent.com/jQAmlGUkuJGc4TjZs2OEUeB5Gy3dCpKCWqfgVmab5NvM_43oed2qhVhrlEajccjJV6VkDFCEXws_6t6StKKLTY4"],null,[255,228,70,255],null,null,null,2],[[null,2,[2880,1440],[null,null,"https://play-lh.googleusercontent.com/WKPX-SpXZ4CfKtyntUrnJqtrzp06G0jPX7TZlhEALf4gOl-2ZwRVlyLj4sNamAMTNQAgz7J_XSMB1mu7TILZ"]],[null,2,[2880,1440],[null,null,"https://play-lh.googleusercontent.com/ToiqeQRz_bFxgcSEtw0Dnu7PSjNYk0-hz8AYZFSipkZae5W7nSjIcn6hlpIvKU_5hEhlKBvjTAAUhTGhKJHDUg"]],[null,2,[2880,1440],[null,null,"https://play-lh.googleusercontent.com/t-KmaucIn6can3R0HXmwys7Yb_aq1oX1JnNIB3noZVb48