,[2064,2752],[null,null,"https://play-lh.googleusercontent.com/xPW0GzwNwXJZIVdG47PhBcelhMeHxdJ17M2thJvwX9QWyVNM1z-mW9CON1Q8JZEWHoOkK1d-CSJl_lkVjo6opy4"]],[null,2,[2064,2752],[null,null,"https://play-lh.googleusercontent.com/OqQpg86BRjRhTwEU-CogSSctfmbzfWHLMgIHMkeh-k1oa8PW1BkgRdtWOBLgljK6FBxOZuJeK5QLZLs3D2TQTA"]]],"Knowt: AI Flashcards \u0026 Notes",["4.5",4.4752474],"Education",null,null,[null,[[0,"USD",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.knowt.app\u0026rdid\u003dcom.knowt.app\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,"/store/apps/details?id\u003dcom.knowt.app"]],["qgJCGkAIBhIVChMKDWNvbS5rbm93dC5hcHAQARgDShMImozA7Z/plgMVqKWDAx1qqROt+gEPCg0IABIJCgVlbi1VUxAA"],null,[null,"Discover a new way to study with Knowt, the all-in-one study app trusted by 7,000,000+ students. On top of being the #1 Flashcard App with Free Learn mode, Knowt also has unique AI features designed to save you time when studying. With one click, turn your notes into flashcards, or ask our AI to summarize your lecture videos and whip up flashcards on the key info for you. Knowt creates practice tests from any note, pdf, or video to help you prepare for exams. We offer a more efficient way to study, join us and take your learning to the next level with Knowt.\u003cbr\u003e\u003cbr\u003e\u003cb\u003eWhat can you do on Knowt?\u003c/b\u003e\u003cbr\u003e\u003cbr\u003e🧠 Make flashcards sets: Use our AI flashcard maker to create your own set or grab some from popular sites like Quizlet.\u003cbr\u003e\u003cbr\u003e✍️ Turn your notes into flashcards and practice : Upload your notes and let our AI makes flashcards and practice tests to help you learn the material better.\u003cbr\u003e\u003cbr\u003e🚀 Study with Free Learn Mode : Master your flashcards with unlimited rounds of learn mode or one of our other study modes \u003ci\u003e (Practice Test, Match, Spaced Repetition) \u003c/i\u003e\u003cbr\u003e\u003cbr\u003e📜 Efficient note-taking: Use our AI note-taking feature to take notes faster\u003cbr\u003e\u003cbr\u003e📚Spaced Repetition : Nail your tests with our scientifically proven algorithm that helps you remember your flashcards longer\u003cbr\u003e\u003cbr\u003e📌 Free AP Study Guides : Check out the Exams Tab for free AP exam study guides, flashcards, and practice tests.\u003ci\u003e (We\u0026#39;re adding more exams soon!)\u003c/i\u003e\u003cbr\u003e\u003cbr\u003e🦉 Explore Free Learning Resources: Choose from millions of digital flashcard sets, class notes, study guides, and pdfs on a wide range of subjects, all created by fellow students.\u003cbr\u003e\u003cbr\u003e💻 Seamless Sync: All your stuff syncs between the mobile app and website, making it easy to pick up where you left off, regardless of the device you\u0026#39;re using.\u003cbr\u003e\u003cbr\u003e…\u003cbr\u003e\u003cbr\u003eDownload the new Knowt App today and take your notes \u0026amp; flashcards wherever you go. Improve your grades and unleash the power of AI to learn better \u0026amp; faster.\u003cbr\u003e\u003cbr\u003e\u003cb\u003eTerms of Service : \u003c/b\u003e knowt.com/terms\u003cbr\u003e\u003cb\u003e Privacy Policy :\u003c/b\u003e knowt.com/privacy\u003cbr\u003e…………………………………\u003cbr\u003e\u003cbr\u003e\u003cb\u003e Join the Knowt Community! 👉\u003c/b\u003e\u003cbr\u003e\u003cbr\u003eDiscord: https://knowt.com/discord\u003cbr\u003eTikTok: https://www.tiktok.com/@getknowt\u003cbr\u003eInstagram: https://www.instagram.com/getknowt\u003cbr\u003e\u003cbr\u003e…………………………………\u003cbr\u003e\u003cbr\u003eWe are committed to protecting your personal information and your right to privacy. If you have any questions or concerns about our practices with regard to your personal information, please contact us at contact@knowt.com"],"Knowt","500,000+",null,"",null,null,null,null,[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/E70QqtwngN49-MUcODDMMd3aGAmkJ8iCO1rYHk-1t_PWRBQahmx_AlAVzbUQ2kyUqsZLnD8zTrN9HH2izZarDZE"],null,[247,247,247,255]],null,["Everyone 10+",[null,2,[512,512],[null,null,"https://play-lh.googleusercontent.com/csiz76udPjXmaJddU_1sanHGlQAAbKkvlprK3DSUNmwu1nY3U6qnXRrI2IDMaivooYK1x11oxz3PEO4z"]],null,[null,"Users Interact"],[null,"\u003ca href\u003d\"https://support.google.com/googleplay?p\u003dappgame_ratings\"\u003eLearn more\u003c/a\u003e"],0,null,[null,2,[272,272],[null,null,"https://play-lh.googleusercontent.com/bxs95MghtAOuZR_LPwVCUmUPYEvXsGVOH3chF1OCX0-Ns_S0qdHnzml2CGCgOGbYlftKsmt9gtpxLb8U"]],[null,null,null,null,null,[null,null,"https://support.google.com/googleplay?p\u003dappgame_ratings"]]],[[[[[null,[[0,"USD",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.knowt.app\u0026rdid\u003dcom.knowt.app\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]]],["Install"],null,["CgYKBENBRT0\u003d"]]]],[2],null,[1,1,0],["$7.99 - $249.99 per item",[0]]],[["app.mmap.mobile",7],[null,2,[512,512],[null,null,"https://play-lh.googleusercontent.com/Sb2OIPQ0QyUWCXLrrdooiLiv9Yb2ACGB59-aEsJJ9Xz2lWNInEklh1f28Tj1tRnvpX7V39SmQtCO3YXvhwNbnA"],null,[18,17,18,255],null,null,null,2],[[null,2,[2688,1242],[null,null,"https://play-lh.googleusercontent.com/37AH98uH2Rvf--XnNjytP9InAarnhMs-2HYx1V78wyDDB4DBb0niX8Meliy1Li7RlwVAdN8vPH4TvPOLuAO7WQ"]],[null,2,[2688,1242],[null,null,"https://play-lh.googleusercontent.com/PTkp97G7If1V9fG6Nr4LyH0c7iCvHL89a1PA29pa7jQZED4zaH7ihzQKeincUhz-6F9zOd8bHcM0Z0z3cGEzdQ"]],[null,2,[2688,1242],[null,null,"https://play-lh.googleusercontent.com/xL1zxhaGAIng3jK58dsJlOgAwy1y9FZBiUnCemgZC31Hww7_ZI9uX6s464AIQjJO-NyiPht6opVXqAnMBR4E"]],[null,2,[2688,1242],[null,null,"https://play-lh.googleusercontent.com/37AH98uH2Rvf--XnNjytP9InAarnhMs-2HYx1V78wyDDB4DBb0niX8Meliy1Li7RlwVAdN8vPH4TvPOLuAO7WQ"]],[null,2,[2688,1242],[null,null,"https://play-lh.googleusercontent.com/PTkp97G7If1V9fG6Nr4LyH0c7iCvHL89a1PA29pa7jQZED4zaH7ihzQKeincUhz-6F9zOd8bHcM0Z0z3cGEzdQ"]],[null,2,[2688,1242],[null,null,"https://play-lh.googleusercontent.com/xL1zxhaGAIng3jK58dsJlOgAwy1y9FZBiUnCemgZC31Hww7_ZI9uX6s464AIQjJO-NyiPht6opVXqAnMBR4E"]],[null,2,[2688,1242],[null,null,"https://play-lh.googleusercontent.com/37AH98uH2Rvf--XnNjytP9InAarnhMs-2HYx1V78wyDDB4DBb0niX8Meliy1Li7RlwVAdN8vPH4TvPOLuAO7WQ"]],[null,2,[2688,1242],[null,null,"https://play-lh.googleusercontent.com/PTkp97G7If1V9fG6Nr4LyH0c7iCvHL89a1PA29pa7jQZED4zaH7ihzQKeincUhz-6F9zOd8bHcM0Z0z3cGEzdQ"]],[null,2,[2688,1242],[null,null,"https://play-lh.googleusercontent.com/xL1zxhaGAIng3jK58dsJlOgAwy1y9FZBiUnCemgZC31Hww7_ZI9uX6s464AIQjJO-NyiPht6opVXqAnMBR4E"]]],"Soundmap - Find Your Songs",["4.5",4.4769135],"Music \u0026 Audio",null,null,[null,[[0,"USD",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dapp.mmap.mobile\u0026rdid\u003dapp.mmap.mobile\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,"/store/apps/details?id\u003dapp.mmap.mobile"]],["qgJEGkIIBxIXChUKD2FwcC5tbWFwLm1vYmlsZRABGANKEwiajMDtn+mWAxWopYMDHWqpE636AQ8KDQgAEgkKBWVuLVVTEAA\u003d"],null,[null,"Soundmap is for REAL MUSIC FANS! Find songs, trade songs, complete artists quests, build your ultimate collection, and show how much you love MUSIC!\u003cbr\u003e\u003cbr\u003eMap Drops: Walk around with the app open to collect songs from nearby drops. Each song can be common, uncommon, rare, shiny, or epic. Get those drops before they are claimed by someone else!\u003cbr\u003eTrade: Have a song you want? See if anyone is trading them on the market. Put up your best offer and negotiate!\u003cbr\u003eQuests: Love an artists? Complete their artists quests to collect all their discography!\u003cbr\u003e\u003cbr\u003eLocation Permission Declaration: Soundmap is a location-based app where you explore the world and find music. Users have to opt in to share location either always or while using the app. Both permission requests will be presented during onboarding. By signing up, you agree to our Terms of Service and Privacy Policy. We collect location data to enable app usage even when the app is closed or not in use.\u003cbr\u003e\u003cbr\u003eTerms of Service: https://www.notion.so/intonation/Music-Map-Terms-of-Service-06a68afb2654438090bea89dbf02ba08?pvs\u003d4\u003cbr\u003ePrivacy Policy: https://www.notion.so/intonation/Music-Map-Privacy-Policy-6755e1c43ee74fe0b4060d2176a6ba0d?pvs\u003d4"],"SuperStar Labs","500,000+",null,"",null,null,null,null,[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/EUufnt6et0LKJyUScCcCZjmYx35R4Gux5N0lWzZHA5j33e2SmpsFr58IbNKP9eeHnJD7MtFHYgMxGKDb0_tf06M"],null,[120,0,255,255]],null,["Teen",[null,2,[512,512],[null,null,"https://play-lh.googleusercontent.com/mw_NfsvKM8m6RPv8Fz2GQawCOsqWv010saMnc7zbWalMxuaA9IY8h7E0VMieLxSxAFB98NFeYqbFrXXq"]],[null,"Diverse Content: Discretion Advised"],[null,"Users Interact, Shares Location, In-App Purchases"],[null,"\u003ca href\u003d\"https://support.google.com/googleplay?p\u003dappgame_ratings\"\u003eLearn more\u003c/a\u003e"],0,null,[null,2,[272,272],[null,null,"https://play-lh.googleusercontent.com/xl04GurQer374yogi24hRkvUcXtMStMOcOo86Sprmrid9j6wQHF0d9xMh73CwUEg57lbsGIwpOXgrJ927Q"]],[null,null,null,null,null,[null,null,"https://support.google.com/googleplay?p\u003dappgame_ratings"]]],[[[[[null,[[0,"USD",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dapp.mmap.mobile\u0026rdid\u003dapp.mmap.mobile\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]]],["Install"],null,["CgYKBENBRT0\u003d"]]]],[2],null,[1,1,0],["$0.99 - $499.99 per item",[0]]],[["com.habitrpg.android.habitica",7],[null,2,[512,512],[null,null,"https://play-lh.googleusercontent.com/ZriBVMfdmkJSABIh3vnrbKp5wD__dPuM8UWCTyGk_oQR6XZpNXY7vyVVPgXr-eRBQ5xrk52PcUgFqCiP7QzEaA"],null,[106,48,211,255],null,null,null,2],[[null,2,[2688,1344],[null,null,"https://play-lh.googleusercontent.com/nj5rkn_DI0xFqVR5RGl4Anp1ndw8ggzG1SQO_Dx1LCl-xN_bFpk94e7vmvkftSwpi_HzZIZGDA9yaPPgik8S7PU"]],[null,2,[2688,1344],[null,null,"https://play-lh.googleusercontent.com/LvpKOQmJGlU4Ie28KzWvmmUQ_Z4AoN3ZVdQtdc9LqU2IPiCb9rQs64eSvD4CZkhdqvkllyinlLN9sFbUBTMV"]],[null,2,[2688,1344],[null,null,"https://play-lh.googleusercontent.com/Ndyi0JPKllxmNXgvowSmdx1tVr3mGmQ05v63zdI7kp91GLsbRouSNDZ1a82XX5Dft7AT5QJ00ca3Dc5HHwJ59w"]],[null,2,[2688,1344],[null,null,"https://play-lh.googleusercontent.com/qzuvsqCeoThwNhGL8IBFVHiWk3SCa7GLaIoBZRscBmcPPSNKWWZIstcg4oz4F6jWneKZ8ey3VGQtFS6OOmZ6CJM"]],[null,2,[2688,1344],[null,null,"https://play-lh.googleusercontent.com/ijx42asBJI_m-QRwbwZF6-1oGXSPhgTPcFBk-perVcern9inCUH8uVqjJOj8VnoMP3vGcLI1BsbNIdrs2d0S"]],[null,2,[2688,1344],[null,null,"https://play-lh.googleusercontent.com/mTI-GcVzBxi9VvtTzFw_f1rlI_hxwbQtKaOcR5xtHuLwLcPGtrOB4H18DV3Zg60tLKoL8sPKvpHfPgEMxl4laA"]],[null,2,[2688,1344],[null,null,"https://play-lh.googleusercontent.com/Lc0CDZnfiLxwMo96-HyBmaROL5JxkdGOrPS14-vTWeZiXTGf6EuQZS9KJ3WE6DljoJTo2Xl04b8-S8zf-k3c"]],[null,2,[2688,1344],[null,null,"https://play-lh.googleusercontent.com/cKHG0MpbqKTgPuu6gsY1RftxvccdMo8oAoyQrjX9c9X4NsD0q5eE-dJhoUCSffkH88AQpi64kP9IgjHrZoXAww"]],[null,2,[792,792],[null,null,"https://play-lh.googleusercontent.com/PiSbXEDBKGPoGaRT4jhPjjyY6x8U7yjFSWriKycD1gq1aFC1a5ZWdFdggO_K5pqMPpqTIx7dqESe2Ak9fuTC"]],[null,2,[792,792],[null,null,"https://play-lh.googleusercontent.com/Uy0L7FOQ2evgt7oz3Gw_azh2q8nAwquisY8x8QgWIscd-PkK3iTvpdS0GJRGfXLwu0Emm0Ox11tmQurUSZKsnQA"]],[null,2,[792,792],[null,null,"https://play-lh.googleusercontent.com/WkqwbnlEnDZMsbxLE9DqhEAKzKFqWg4hO9-RTGDZm9RyNcle8Mtf1QurKclTuAz5MMSwWeNLeBiKK2QQluI6yQ"]],[null,2,[792,792],[null,null,"https://play-lh.googleusercontent.com/-MdbHPHwPyCMTDw98zDnTQwOy4tD7J_SCgI_wKiYWoR_dwyRtCpfl-VA-GJnOiIBLMEU2xxcWykLaRpaul5Xzg"]],[null,2,[792,792],[null,null,"https://play-lh.googleusercontent.com/4DzTfps3yIln4WurjrjBUHbtXSlyhJ86ipvC1ZSnn90LA03zAom8trWpS8owss6PY5u_1Qksg8yv-L7tQ4jA4xE"]]],"Habitica: Gamify Your Tasks",["4.7",4.6663923],"Productivity",null,null,[null,[[0,"USD",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.habitrpg.android.habitica\u0026rdid\u003dcom.habitrpg.android.habitica\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,"/store/apps/details?id\u003dcom.habitrpg.android.habitica"]],["qgJSGlAICBIlCiMKHWNvbS5oYWJpdHJwZy5hbmRyb2lkLmhhYml0aWNhEAEYA0oTCJqMwO2f6ZYDFailgwMdaqkTrfoBDwoNCAASCQoFZW4tVVMQAA\u003d\u003d"],null,[null,"Habitica is a free habit-building and productivity app that uses retro RPG elements to gamify your tasks and goals.\u003cbr\u003eUse Habitica to help with ADHD, self care, New Year’s resolutions, household chores, work tasks, creative projects, fitness goals, back-to-school routines, and more!\u003cbr\u003e\u003cbr\u003eHow it works:\u003cbr\u003eCreate an avatar then add tasks, chores, or goals you’d like to work on. When you do something in real life, check it off in the app and receive gold, experience, and items that can be used in-game!\u003cbr\u003e\u003cbr\u003eFeatures:\u003cbr\u003e  • Automatically repeating tasks scheduled for your daily, weekly, or monthly routines\u003cbr\u003e  • Flexible habit tracker for tasks you want to do multiple times a day or only once in awhile\u003cbr\u003e  • Traditional to do list for tasks that only need to be done once\u003cbr\u003e  • Color coded tasks and streak counters help you see how you’re doing at a glance\u003cbr\u003e  • Leveling system to visualize your overall progress\u003cbr\u003e  • Tons of collectable gear and pets to suit your personal style\u003cbr\u003e  • Inclusive avatar customizations: wheelchairs, hair styles, skin tones, and more\u003cbr\u003e  • Regular content releases and seasonal events to keep things fresh\u003cbr\u003e  • Parties let you team up with friends for extra accountability and battle fierce foes by completing tasks\u003cbr\u003e  • Challenges offer shared task lists you can add to your personal tasks\u003cbr\u003e  • Reminders and widgets to help keep you on track\u003cbr\u003e  • Customizable color themes with dark and light mode\u003cbr\u003e  • Syncing across devices\u003cbr\u003e\u003cbr\u003e\u003cbr\u003eWant even more flexibility to take your tasks on the go? We have a Wear OS app on the watch!\u003cbr\u003e\u003cbr\u003eWear OS features:\u003cbr\u003e  • View, create, and complete Habits, Dailies, and To do’s\u003cbr\u003e  • Receive rewards for your efforts with experience, food, eggs, and potions\u003cbr\u003e  • Track your stats with dynamic progress bars\u003cbr\u003e  • Show off your stunning pixel avatar on the watch face\u003cbr\u003e\u003cbr\u003e\u003cbr\u003e—\u003cbr\u003e\u003cbr\u003e\u003cbr\u003eRun by a small team, Habitica is an open-source app made better by contributors who create translations, bug fixes, and more. If you’d like to contribute, you can check out our GitHub or reach out for more information!\u003cbr\u003eWe highly value community, privacy, and transparency. Rest assured, your tasks remain private and we never sell your personal data to third parties.\u003cbr\u003eQuestions or feedback? Feel free to reach us at admin@habitica.com! If you’re enjoying Habitica, we’d be thrilled if you leave us a review.\u003cbr\u003eStart your journey towards productivity, download Habitica now!"],"HabitRPG, Inc.","5,000,000+",null,"",null,null,null,null,[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/iKyLzHqiMKYqT9-C7EJHVCmJqQ0m3J51m6m37CkBdeVgXiJVZtQNR-ny8apxTVPnVNLjhPKselHpIWnkJwLjPA"],null,[113,66,224,255]],null,["Everyone",[null,2,[512,512],[null,null,"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-