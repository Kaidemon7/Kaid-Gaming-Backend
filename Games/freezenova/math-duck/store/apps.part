/play-lh.googleusercontent.com/SX6S7B91lwegCcyaxTifz4hDVss0VlpQ1heLssr0QDTBzujy6Jj2i9oq07MbVTxsI4-Re2Sxp6CifYXK8RVT"]],[null,2,[2560,1600],[null,null,"https://play-lh.googleusercontent.com/JDUrjLqSpLreuL7LlzNHDstxYkznKO6loAzVYP9j8o78Myvgi0aHyHPtWaQPqz4strvg7V02vhgq-PF_FfnJ"]],[null,2,[2560,1600],[null,null,"https://play-lh.googleusercontent.com/CWTe0BzZssYIn3_3YZvLh2d2-byfPJ_UCa19e8tIXJIsRC-ONO6hV0k9tByLTaWIGiDSqvmiJsjACRRo_tqyLQ"]],[null,2,[2560,1600],[null,null,"https://play-lh.googleusercontent.com/aUubLs4kQ2nUqgp9_EH51yAG552KINt4MZ4XWorXC2gEf4ajPN7shJN_WfM-FO-m_jy2-ANMC9oux4s8TOopfos"]],[null,2,[2560,1600],[null,null,"https://play-lh.googleusercontent.com/3FbXkwTc2rnZWqBTQ8GSn6Qa9KfcGQ_bRNgVxhxrALqLzfh1nTx4A050xu48UoIhgBd2wgD5UZ7gTSJ7DeoZ9g"]],[null,2,[2560,1600],[null,null,"https://play-lh.googleusercontent.com/KemUSVbJVCNXj2NnOZfpClXAMo9DoHFk1Sq87sEI-YeXU57noCiHQaw5NCSdV2Csw7uw0xFIEyW640QvSe-_"]],[null,2,[2560,1600],[null,null,"https://play-lh.googleusercontent.com/6qcUsZw4IItBmF3anOO8-lUhw-IFNGMUj3Y3_1kWSfyhbi7n8erveLuVO3xeV4YIjmz6t52GxxY4YKqIMg8jow"]]],"Firefox Fast \u0026 Private Browser",["4.6",4.611866],"Communication",null,null,[null,[[0,"USD",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dorg.mozilla.firefox\u0026rdid\u003dorg.mozilla.firefox\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,"/store/apps/details?id\u003dorg.mozilla.firefox"]],["qgJeGlwIERIbChkKE29yZy5tb3ppbGxhLmZpcmVmb3gQARgDShMImozA7Z/plgMVqKWDAx1qqROtmgETCJivybz56JYDFYaigwMdNY4iNvoBDwoNCAASCQoFZW4tVVMQAA\u003d\u003d"],null,[null,"\u003cb\u003eThe internet. As it should be.\u003c/b\u003e\u003cbr\u003e\u003cbr\u003eFirefox is a \u003cb\u003eprivate web browser\u003c/b\u003e designed to protect your data, block trackers and make browsing fast, secure and simple. Whether you’re looking for an incognito browser, a private search experience, or a reliable browser for everyday use, Firefox puts you first.\u003cbr\u003e\u003cbr\u003e\u003cb\u003eWhy people choose Firefox\u003c/b\u003e\u003cbr\u003e\u003cbr\u003e\u003cb\u003eMore privacy, less tracking\u003c/b\u003e – Firefox automatically blocks social media trackers, cross-site cookies, crypto miners and fingerprinting scripts.\u003cbr\u003e\u003cb\u003ePrivate browsing that protects you\u003c/b\u003e – Open private tabs that don’t save your history, searches, or cookies. Lock them with your device security for extra protection.\u003cbr\u003e\u003cb\u003eFast, smooth performance\u003c/b\u003e – Load pages faster by blocking trackers and reducing unnecessary data usage.\u003cbr\u003e \u003cb\u003eSearch your way\u003c/b\u003e – Use your preferred private search engine or switch easily from the search bar.\u003cbr\u003e\u003cb\u003ePasswords made simple\u003c/b\u003e – Generate, store and autofill passwords securely.\u003cbr\u003e\u003cb\u003eTabs that work for you\u003c/b\u003e – Easily organize and switch between tabs and sync them across devices to pick up where you left off.\u003cbr\u003e\u003cb\u003eFocus without distractions\u003c/b\u003e – Reader View strips away clutter, while picture-in-picture lets you multitask with videos.\u003cbr\u003e\u003cb\u003eControl your experience\u003c/b\u003e – Add extensions like ad blockers, customize settings and choose how you browse.\u003cbr\u003e\u003cb\u003eMake it yours\u003c/b\u003e – Customize your home screen, layout and shortcuts for a more personal browsing experience.\u003cbr\u003e\u003cb\u003eAI on your terms\u003c/b\u003e – Turn AI completely off or customize it feature by feature.\u003cbr\u003e\u003cb\u003eQuick page summaries\u003c/b\u003e – Shake your phone to cut through long pages and get the key points.\u003cbr\u003e\u003cb\u003eSync across devices\u003c/b\u003e – Access your bookmarks, tabs and passwords anywhere you use Firefox.\u003cbr\u003e\u003cbr\u003e\u003cb\u003ePrivate by default\u003c/b\u003e\u003cbr\u003eFirefox is built to protect you. \u003cb\u003eEnhanced Tracking Protection\u003c/b\u003e automatically blocks common trackers, while \u003cb\u003eTotal Cookie Protection\u003c/b\u003e keeps cookies isolated to the sites where they belong. When you need more privacy, private browsing mode ensures your history, searches and cookies aren’t saved. Private tabs can also lock automatically, so your activity stays yours.\u003cbr\u003e\u003cbr\u003e\u003cb\u003eYour browser. Your rules.\u003c/b\u003e\u003cbr\u003eFirefox puts you in charge of your internet. Add privacy or productivity \u003cb\u003eextensions\u003c/b\u003e, including ad blockers, move your search bar, choose your default search engine and tailor your browser to how you use the web. Sync your data across devices for a seamless, consistent experience.\u003cbr\u003e\u003cbr\u003e\u003cb\u003eFocus with Firefox. Fast, secure and built around you \u003c/b\u003e\u003cbr\u003eFirefox is designed to help you stay focused with faster, more secure browsing. \u003cb\u003eReader Mode\u003c/b\u003e removes clutter from articles, \u003cb\u003ePicture-in-Picture\u003c/b\u003e keeps videos accessible while you multitask and \u003cb\u003eTracker Blocking\u003c/b\u003e helps pages load faster. Built-in password management and private browsing keep everyday browsing simple and protected.\u003cbr\u003e\u003cbr\u003e\u003cb\u003eBuilt for people, not profit\u003c/b\u003e\u003cbr\u003eFirefox was created in 2004 by Mozilla as a faster, more private and customizable browser designed to put people first. Today, Mozilla remains a nonprofit working to make the internet — and the time you spend on it — better.\u003cbr\u003e\u003cbr\u003eLearn more about Mozilla: https://www.mozilla.org\u003cbr\u003eTerms of Use: https://www.mozilla.org/about/legal/terms/firefox/\u003cbr\u003ePrivacy Policy: https://www.mozilla.org/privacy/firefox\u003cbr\u003eLatest news: https://blog.mozilla.org"],"Mozilla","500,000,000+",null,""