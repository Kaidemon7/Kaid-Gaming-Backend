ma, Anime, Show",["4.7",4.6930337],"Entertainment",null,null,[null,[[0,"USD",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.iqiyi.i18n\u0026rdid\u003dcom.iqiyi.i18n\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,"/store/apps/details?id\u003dcom.iqiyi.i18n"]],["qgJZGlcIBxIWChQKDmNvbS5pcWl5aS5pMThuEAEYA0oTCJqMwO2f6ZYDFailgwMdaqkTrZoBEwiYr8m8+eiWAxWGooMDHTWOIjb6AQ8KDQgAEgkKBWVuLVVTEAA\u003d"],null,[null,"Looking for the next viral C-Drama, a heart-pounding BL series, or trending short drama? iQIYI brings you a premium library of Asian content that goes beyond the basics. \u003cbr\u003e\u003cbr\u003eDownload iQIYI now and immerse yourself in a world of endless entertainment, including our exclusive iQIYI Originals you won\u0026#39;t find anywhere else.\u003cbr\u003e\u003cbr\u003e[Why Choose iQIYI?]\u003cbr\u003e🔥 iQIYI Originals \u0026amp; Exclusives: Watch high-budget, award-winning productions available only here.\u003cbr\u003e🌈 The Ultimate BL \u0026amp; Romance Library: The go-to destination for the world’s most talked-about series.\u003cbr\u003e⏳ Binge-Worthy Short Dramas: Short on time? Our short dramas give you all the spice, revenge, and romance in bite-sized episodes— perfect for your commute.\u003cbr\u003e\u003cbr\u003e\u003cbr\u003e[Features Built for You]\u003cbr\u003e🌟 Watch for Free: Access a massive selection of high-quality shows at no cost.\u003cbr\u003e🌍 Multi-Language Experience: Don’t let a language barrier stop you. We provide professional subtitles and a fully localized UI in English, Spanish, Thai, Malay, and more.\u003cbr\u003e🪧 VIP Perks: Skip the ads, unlock \u0026quot;Early Access\u0026quot; to new episodes, and enjoy exclusive member-only content.\u003cbr\u003e📱 Multi-Device Sync: Start watching on your phone, tablet, or TV, and pick up exactly where you left off, anytime, anywhere.\u003cbr\u003e💡 Seamless User Experience: Navigate effortlessly with our clean, intuitive interface, designed to help you easily discover your next favorite show.\u003cbr\u003e\u003cbr\u003eKeep your watchlist packed with new titles added every single week. Download iQIYI now and start your journey into the world of premium Asian storytelling!\u003cbr\u003e\u003cbr\u003eGot questions? We’re here to help: contactus@qiyi.com\u003cbr\u003eFollow the fun on Instagram \u0026amp; Facebook: @iQIYI\u003cbr\u003eWeb: https://www.iq.com/"],"iQIYI","100,000,000+",null,"",null,null,null,null,[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/1CnHiCtbZ-lQphkwxO5GoI4sxNdbqL2yboSdKdnVXfI4W4A_N3PUMNe-4tRWAvlqZhGtvQ9kxhRImF5K877LfQ"],null,[26,25,39,255]],null,["Teen",[null,2,[512,512],[null,null,"https://play-lh.googleusercontent.com/mw_NfsvKM8m6RPv8Fz2GQawCOsqWv010saMnc7zbWalMxuaA9IY8h7E0VMieLxSxAFB98NFeYqbFrXXq"]],[null,"Diverse Content: Discretion Advised"],[null,"In-App Purchases"],[null,"\u003ca href\u003d\"https://support.google.com/googleplay?p\u003dappgame_ratings\"\u003eLearn more\u003c/a\u003e"],0,null,[null,2,[272,272],[null,null,"https://play-lh.googleusercontent.com/xl04GurQer374yogi24hRkvUcXtMStMOcOo86Sprmrid9j6wQHF0d9xMh73CwUEg57lbsGIwpOXgrJ927Q"]],[null,null,null,null,null,[null,null,"https://support.google.com/googleplay?p\u003dappgame_ratings"]]],[[[[[null,[[0,"USD",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.iqiyi.i18n\u0026rdid\u003dcom.iqiyi.i18n\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]]],["Install"],null,["CgYKBENBRT0\u003d"]]]],[2],null,[1,1,0],["$0.49 - $304.99 per item",[0],[]]],[["com.adobe.spark.post",7],[null,2,[512,512],[null,null,"https://play-lh.googleusercontent.com/1y0mQ4xqxHHWtpjgVjNB648mzSm-qJv2NW2sUdifZaW9o37DG_VUPr_bs8OXsnZ7IuHx5KzKOe2mWFlC3la-4g"],null,[0,11,29,255],null,null,null,2],[[null,2,[2208,124