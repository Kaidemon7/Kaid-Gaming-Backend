sercontent.com/VL9EODdlJuhSBWcwfmBVtWXbJEQvAO-oe4EtJjY5gEeUSGMVvulC9FxeQVZvxAyWtbZ4U55As37d8x7hAcRgw20"]],[null,2,[3840,2160],[null,null,"https://play-lh.googleusercontent.com/0MExiIj7YZMUXJMGDqt1nAScMckdxLepTGW5xBXndHdQB77P-ufBY7vYJ3iVrBbsxbta94SnYu5U3pD5z7fKsxM"]],[null,2,[2160,3840],[null,null,"https://play-lh.googleusercontent.com/8mTqgJTPgi2zJyfPbTo1h7JueZCdn-k2gr9fbeD3H2oNsCVpS6R_06DMF4jQ6MZwe4DjcOJrdPgIJViaFBCbcA"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/ONWdRWYeKSe7EHIndK9D9QK6RcM7gvQBIcv9kchpSOA6I2iXdvPFPgW8sdkQ0gboSJPMUBsNZPsGSk0-dNH0Ez8"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/aIfVbTYShCRa7mIsYhTsE3irU8_3O5PwJnh1vCWZO_-YFsIPEEF2_2xtDngpP4z-DhYlE92qMfQL4mkVa--gqHk"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/p_6ahZ500L3P_M9BTCw6LeG_tiARHoHNvcu6hInSCafq0Sz-1Z2t4PsFDtJdr3nrUEr-teT0pvs2whg-UO3I"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/EAmIATOoMPMkiyp2eTuHkhRopjmPLcCxqIBXr5jIzixEDpqWyBKhN-2Vk3H_wOt6-g3sAXWcFMyOeG6aRGTpbA"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/xjFggxhUBzCje6zLuWXwW1_AnqlQcAuFLTzc2RrE_u0C5CkShP8FJJ6to7DxWTWIeepCVqsKJJdclSZ_YiOEGw"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/VL9EODdlJuhSBWcwfmBVtWXbJEQvAO-oe4EtJjY5gEeUSGMVvulC9FxeQVZvxAyWtbZ4U55As37d8x7hAcRgw20"]]],"Gratitude: Self-Care Journal",["4.9",4.8806114],"Lifestyle",null,null,[null,[[0,"USD",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.northstar.gratitude\u0026rdid\u003dcom.northstar.gratitude\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,"/store/apps/details?id\u003dcom.northstar.gratitude"]],["qgKXARqUAQgBShMImozA7Z/plgMVqKWDAx1qqROt+gEPCg0IABIJCgVlbi1VUxAAugRoCh0KF2NvbS5ub3J0aHN0YXIuZ3JhdGl0dWRlEAEYAxo6CjNtY19vcnBoYW5faG9wZW1heHhpbmdfcG9zaXRpdmVfdGhpbmtpbmdfMjAyNl8wOV9mY2MQmQEYAyILCgASBzEyOTVlZjI\u003d"],null,[null,"The Gratitude app is a carefully-designed self-care tool to help you focus on your mental health.\u003cbr\u003e\u003cbr\u003eWith gratitude journal, affirmations, vision board, and daily motivation content, Gratitude provides you with all the tools and reminders you need to gain motivation and develop a healthy self-love routine in your life.\u003cbr\u003e\u003cbr\u003eTo live a happy and fulfilling life, it is important for us to have good mental health and a strong sense of self-love.\u003cbr\u003e\u003cbr\u003eAnd, as the app is completely private, you can always be assured that your precious journal entries, affirmations, and vision board are for your eyes only.\u003cbr\u003e\u003cbr\u003eHere are the tools that you will find in the Gratitude app:\u003cbr\u003e\u003cbr\u003e1. 📖 GRATITUDE JOURNAL\u003cbr\u003e\u003cbr\u003eA gratitude journal or diary opens up your eyes to reflect on all the little blessings in your life. \u003cbr\u003e\u003cbr\u003eIn daily life, we can lose sight of what we are fortunate to have and by keeping a journal you can slowly and steadily shift your perspective to focus on what is good in your life. \u003cbr\u003e\u003cbr\u003eThe Gratitude app will send you reminders with prompts to help you build the habit of journaling. \u003cbr\u003e\u003cbr\u003eYou can also add photos to your journal entries, build a gratitude journal streak, and access hundreds of journal prompts.\u003cbr\u003e\u003cbr\u003e2. 💗POSITIVE AFFIRMATIONS\u003cbr\u003e\u003cbr\u003eIf you’ve heard about manifestation or the law of attraction, you’ve probably heard about affirmations. \u003cbr\u003e\u003cbr\u003ePositive daily affirmations change our self-talk to focus on more loving and kind thoughts towards ourselves. \u003cbr\u003e\u003cbr\u003eThey give us the motivation we need to keep moving forward and believe in ourselves.\u003cbr\u003e\u003cbr\u003eThe Gratitude app has hundreds of affirmations that you can listen to or read, as per your need. \u003cbr\u003e\u003cbr\u003eYou can also write your own affirmations, add music, and record your voice to them.\u003cbr\u003e\u003cbr\u003ePositive affirmations are a dearly loved tool and with this affirmations app, it is very easy for you to practice them.\u003cbr\u003e\u003cbr\u003e3. 🏞CREATE VISION BOARDS\u003cbr\u003e\u003cbr\u003eAnother super popular manifestation tool is a vision board, also called dream board. The vision board serves as a collage of your dreams and goals in the form of photos, quotes, and affirmations.\u003cbr\u003e\u003cbr\u003eIn the Gratitude app, we’ll help you make a great vision board using sections, goal ideas, and create a video of all your goals together with music. You can also make multiple vision boards!\u003cbr\u003e\u003cbr\u003e4. 🌈DAILY ZEN\u003cbr\u003e\u003cbr\u003eWe understand the need for motivation and inspiration as you build a healthy routine with these self-help tools, which is why Daily Zen is an important part of the app. \u003cbr\u003e\u003cbr\u003eHere, you will find gratitude quotes, motivation quotes, thought switch ideas, thank you cards, affirmations, blog articles, and real-life stories of people who changed their mindset with gratitude.\u003cbr\u003e\u003cbr\u003eOne simple switch can begin a massive change in your life. A self-care tool like Gratitude will help you build a healthy routine to take care of your mental health, achieve your goals, and live a beautiful life."],"Hapjoy Technologies","5,000,000+",null,"",null,null,null,null,[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/WgGCs9KCy0AbR1fT20JH81lkMZrbqSiZ3Gmi0SIoWIgEHeRejaaTUVaYsWEsh4nGjJViw18y3TWe6Tr790cuGA"],null,[251,247,247,255]],null,["Everyone",[null,2,[512,512],[null,null,"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i"]],null,[null,"In-App Purchases"],[null,"\u003ca href\u003d\"https://support.google.com/googleplay?p\u003dappgame_ratings\"\u003eLearn more\u003c/a\u003e"],0,null,[null,2,[272,272],[null,null,"https://play-lh.googleusercontent.com/OBVqgRK7eerY0GPfK8AOzitu5oE9ecC6kG4kURTCb1K41gpqVsN0WjmJwJh-wX8vILzpcc1kYHt56aLN2g"]],[null,null,null,null,null,[null,null,"https://support.google.com/googleplay?p\u003dappgame_ratings"]]],[[[[[null,[[0,"USD",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.northstar.gratitude\u0026rdid\u003dcom.northstar.gratitude\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]]],["Install"],null,["CgYKBENBRT0\u003d"]]]],[2],null,[1,1,0],["$3.99 - $59.99 per item",[0]]],[[null,null,null,null,[null,null,"/store/apps/details?id\u003dcom.northstar.gratitude"]],["qgKXARqUAQgBShMImozA7Z/plgMVqKWDAx1qqROt+gEPCg0IABIJCgVlbi1VUxAAugRoCh0KF2NvbS5ub3J0aHN0YXIuZ3JhdGl0dWRlEAEYAxo6CjNtY19vcnBoYW5faG9wZW1heHhpbmdfcG9zaXRpdmVfdGhpbmtpbmdfMjAyNl8wOV9mY2MQmQEYAyILCgASBzEyOTVlZjI\u003d"],[[null,[[0,"USD",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.northstar.gratitude\u0026rdid\u003dcom.northstar.gratitude\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]]]],[null,"Hopemaxxing: Rewire your brain with positivity"],[null,"Practice radical optimism daily"],[null,2,[2160,3840],[null,null,"https://play-lh.googleusercontent.com/O8VG1Th42cBlvqzKsdvI5RAQv3LSFifkXu_jvnmQlUj2XzI2lRLMCBWSEEDPMCaUxNPq1qDw4zrH"],null,[205,248,255,255]],null,"Trending",[null,null,null,null,[null,null,"/store/apps/editorial?id\u003dmc_hopemaxxing_positive_thinking_2026_09_fcp"]],1,null,["Gratitude: Self-Care Journal"],[[["Lifestyle",[null,null,null,null,[null,null,"/store/apps/category/LIFESTYLE"]],"LIFESTYLE"]]]]],[null,[[["com.dd.doordash",7],[null,2,[512,512],[null,null,"https://play-lh.googleusercontent.com/daqnb5FdirTUewbv81mzwbnhD6_d1ITPYjM-XBFykk3QXRebKeaZLwWjyIbFKzLaEm6c12_wqVEHQhVrX3kO"],null,[255,255,255,255],null,null,null,2],[[null,2,[1920,1080],[null,null,"https://play-lh.googleusercontent.com/pJEuHz8Z4DGLC3acC48Y1j9Bb-DGMbRdpMbl5hdo6DVGz4aIQDX1PAdqUgW7GsRoP55-ak4AiUmHtDmokHXiIH4"]],[null,2,[1920,1080],[null,null,"https://play-lh.googleusercontent.com/boz7_D3E3rPVbtdtWQ0v0e0etmyL3XtEmvYuByblHYTxbUkA3awwUmCIjrD9dGf9uPqi5-S0nY3NfYlEGTTOhQ"]],[null,2,[1920,1080],[null,null,"https://play-lh.googleusercontent.com/fVaRg4ipMY-DXXWgjHW2F9Hu2gU73hZvqNXxwDl4AycKzme7qWaaPvmpBx2EPUqAdjDDYxLUeU5AssJFqQloYA"]],[null,2,[1920,1080],[null,null,"https://play-lh.googleusercontent.com/ELMtB0cdRsfOZKbAh3bR8ol9O258AMwvXFCbK5cGg2jbYJ6uT6q4gNyNfv98Un9iFXWC9K1sM6iF14QlQWRsUQ"]],[null,2,[1920,1080],[null,null,"https://play-lh.googleusercontent.com/LpysOiY9Qg5DUcKJr2If-evUFdJct71VtVY5rrsXrP41tTAjMPnapJZIIK-gB987ErUUjQ3kJ4nHwWQlyPtI0sc"]],[null,2,[1920,1080],[null,null,"https://play-lh.googleusercontent.com/zBuRnChkaOtNFT6TVPMzSoYwhpHMCShqUyraAGZhonO0YQCwPwEQBIgjDMt25tYIZxpeFSQDfEkh2-sLsZ0A6uU"]]],"DoorDash: Food, Grocery, More",["4.7",4.6601014],"Food \u0026 Drink",null,null,[null,[[0,"USD",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.dd.doordash\u0026rdid\u003dcom.dd.doordash\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,"/store/apps/details?id\u003dcom.dd.doordash"]],["qgKLARqIAQgCShMImozA7Z/plgMVqKWDAx1qqROt+gEPCg0IABIJCgVlbi1VUxAAugRcChUKD2NvbS5kZC5kb29yZGFzaBABGAMaNgovbWNfb3JwaGFuX2Vhc3lfYmFja190b19zY2hvb2xfbWVhbHNfMjAyNl8wOF9mY2MQmQEYAyILCgASBzEyN2VmNTc\u003d"],null,[null,"Delivery anywhere you are. DoorDash offers the greatest online selection of your favorite restaurants and stores, facilitating delivery of freshly prepared meals, groceries, OTC medicines, flowers \u0026amp; more. Shop same-day delivery and takeout with DoorDash. \u003cbr\u003e\u003cbr\u003eWith more than 310,000 menus and 55,000+ grocery, convenience \u0026amp; retail stores across 4,000+ cities in the U.S., Canada, Australia, and New Zealand, you’ll find the best of your neighborhood as you shop and order online. Plus, enjoy $0 delivery fees for your first order. Restrictions apply: https://drd.sh/tF5uns/\u003cbr\u003e\u003cbr\u003eIT’S ALL HERE\u003cbr\u003e·Restaurants: Food delivery from local \u0026amp; national restaurants\u003cbr\u003e·Grocery: Fulfill your weekly grocery list, from produce to diapers. Shop diets like gluten-free \u0026amp; vegan.\u003cbr\u003e·Drinks, Snacks \u0026amp; More: Sodas, candy \u0026amp; ibuprofen from stores like 7-Eleven \u0026amp; CVS\u003cbr\u003e·Flowers: Order fresh flowers for occasions like Valentine’s Day\u003cbr\u003e\u003cbr\u003eKEY FEATURES\u003cbr\u003e· Get it now: Get on-demand, same-day delivery\u003cbr\u003e· Schedule deliveries: Order in advance and get it when it\u0026#39;s most convenient for you.\u003cbr\u003e· Real-Time Tracking: See when your order will arrive.\u003cbr\u003e· No Minimums: Order as little or as much as you want.\u003cbr\u003e· Easy Payment: Conveniently pay via Google Pay, Venmo, Paypal, credit card, or SNAP/EBT at participating Mx.\u003cbr\u003e· No-Contact Delivery: Your food will be left in a safe place and you’ll be alerted that it’s ready for you to pick up at your doorstep\u003cbr\u003e\u003cbr\u003eENJOY UNLIMITED $0 DELIVERY FEES WITH DASHPASS\u003cbr\u003eGet unlimited $0 delivery fees and up to 10% off eligible orders from your neighborhood restaurants, grocery stores, and more. Plus, DashPass members get access to exclusive items and offers, and 5% in DoorDash credits back on eligible Pickup orders. Your first 30 days on DashPass are free, then your membership auto-renews at $9.99/month. Cancel anytime.\u003cbr\u003e\u003cbr\u003eNATIONAL RESTAURANT PARTNERS\u003cbr\u003eMcDonald\u0026#39;s, Starbucks, Chick-fil-A, Burger King, Wendy’s, Chipotle, The Cheesecake Factory, Outback Steakhouse, Panera, Chili\u0026#39;s, Subway, Dunkin’ Donuts, Jamba Juice, Panda Express, Moe\u0026#39;s, P.F. Chang’s, Denny’s, Buffalo Wild Wings, Papa John\u0026#39;s, Papa Murphy’s, Jack in the Box, Five Guys, Boston Market, Red Robin, TGI Friday’s, Red Lobster, Qdoba, El Pollo Loco, White Castle, SmashBurger\u003cbr\u003e\u003cbr\u003eGROCERY DELIVERY PARTNERS\u003cbr\u003eSafeway, Albertsons, Aldi, Sprouts Farmers Market, Meijer, Hy-Vee, Grocery Outlet, Winn-Dixie, Smart \u0026amp; Final, BJ’s, Vons, Weis, ACME, Raley’s, Fresh Thyme, Giant Eagle, Bashas’, Bristol Farms and more.\u003cbr\u003e\u003cbr\u003eCONVENIENCE \u0026amp; RETAIL DELIVERY PARTNERS\u003cbr\u003eWalgreens, 7-Eleven, CVS, Rite Aid, Dollar General, Wawa, Sheetz, Casey’s, Total Wine, BevMo!, PetSmart, Sephora, DICK\u0026#39;S Sporting Goods, Tractor Supply, and more\u003cbr\u003e\u003cbr\u003eFIND RESTAURANTS AND STORES NEAR YOU\u003cbr\u003eWe’re growing and currently serving over 4,000 cities across the United States, Puerto Rico, Canada, Australia, and New Zealand including cities such as New York City, Los Angeles, Toronto, Vancouver, BC, Melbourne, Sydney, Montreal and more.\u003cbr\u003e\u003cbr\u003eNotice at Collection (California Residents): https://help.doordash.com/consumers/s/privacy-policy-us#section-11\u003cbr\u003eVisit doordash.com to learn more."],"DoorDash","50,000,000+",null,"",null,null,null,null,[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/hfKS9iTb9CnNnaib9kpO-rKVfGBPgAd9HEHLUzE6Rxzw6t5r-dQZfVG7zemlYPxTS8jIu7yCTOJ_m6-vYhiCpQ"],null,[238,238,236,255]],null,["Everyone",[null,2,[512,512],[null,null,"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i"]],null,[null,"Shares Info"],[null,"\u003ca href\u003d\"https://support.google.com/googleplay?p\u003dappgame_ratings\"\u003eLearn more\u003c/a\u003e"],0,null,[null,2,[272,272],[null,null,"https://play-lh.googleuser