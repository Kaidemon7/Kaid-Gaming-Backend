4.6033034],"Productivity",null,null,[null,[[0,"USD",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dai.perplexity.app.android\u0026rdid\u003dai.perplexity.app.android\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,"/store/apps/details?id\u003dai.perplexity.app.android"]],["qgJkGmIIDhIhCh8KGWFpLnBlcnBsZXhpdHkuYXBwLmFuZHJvaWQQARgDShMImozA7Z/plgMVqKWDAx1qqROtmgETCJivybz56JYDFYaigwMdNY4iNvoBDwoNCAASCQoFZW4tVVMQAA\u003d\u003d"],[[[null,null,"3SKVMV2Gots",[null,null,"https://play.google.com/video/lava/web/player/yt:movie:3SKVMV2Gots?autoplay\u003d1\u0026embed\u003dplay"],"yt:movie:3SKVMV2Gots",null,null,null,null,"AXH1ezl7ywxAWgm3Y500w_yi4wV_H_RZpby-KcrgaufaHoveS72YUEoN5YAp6lh0IcWiKCe5o9F56wqLZ4JMKGuZgANG9931lEIum3EgzK1ITCWJ5nfvpY8TVjYYO39DCGmrhNNzZl3LynO0AAOBFJd0yCmx5rXPtrAJihTdQ5oGE7iyvi-nixh4qR41X7i5pjrJlnDRm3IJttLd5Xu5vDYFgTwKmy-g1t6KPaPtNBGIpqJR18rYOy8hYEydFTJAL6GbZKrgRZYFlT4LCxJLeCizX4vhtZyfgDfs-LOAhfNo4Q\u003d\u003d"],null,1,[null,null,null,[null,null,"https://i.ytimg.com/vi/3SKVMV2Gots/hqdefault.jpg"]]]],[null,"Perplexity—Where Knowledge Begins. The answers you need—right at your finger tips.\u003cbr\u003e\u003cbr\u003eCut through the clutter and get straight to credible, up-to-date answers. This free app syncs across devices and leverages the power of the top AI models from OpenAI, Anthropic, Meta, and more. \u003cbr\u003e\u003cbr\u003eFeatures:\u003cbr\u003e\u003cbr\u003e· Perplexity Pro Search: Guided AI search for deeper exploration.\u003cbr\u003e\u003cbr\u003e· Thread Follow-Up: Keep the conversation going for a deeper understanding.\u003cbr\u003e\u003cbr\u003e· Voice: Instant, up-to-date answers whether you type or say it. \u003cbr\u003e\u003cbr\u003e· Trust Built In: Cited sources for every answer.\u003cbr\u003e\u003cbr\u003e· Discover: Learn new things from the community.\u003cbr\u003e\u003cbr\u003e· Your Library: More than search history, it\u0026#39;s a curation of your discoveries.\u003cbr\u003e\u003cbr\u003eDownload Perplexity now and continue your journey to better knowledge and understanding."],"PerplexityAI","100,000,000+",null,"",null,null,null,null,[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/zbjbjMoXxZPuqf_eExYLaSpU0cE2UmHKOlRMHYce7SjtqnkjEW0--gpAar_56R14DtwRZmUW-06cPJHByteOTQ"],null,[17,17,17,255]],null,["Teen",[null,2,[512,512],[null,null,"https://play-lh.googleusercontent.com/mw_NfsvKM8m6RPv8Fz2GQawCOsqWv010saMnc7zbWalMxuaA9IY8h7E0VMieLxSxAFB98NFeYqbFrXXq"]],[null,"Diverse Content: Discretion Advised"],[null,"In-App Purchases"],[null,"\u003ca href\u003d\"https://support.google.com/googleplay?p\u003dappgame_ratings\"\u003eLearn more\u003c/a\u003e"],0,null,[null,2,[272,272],[null,null,"https://play-lh.googleusercontent.com/xl04GurQer374yogi24hRkvUcXtMStMOcOo86Sprmrid9j6wQHF0d9xMh73CwUEg57lbsGIwpOXgrJ927Q"]],[null,null,null,null,null,[null,null,"https://support.google.com/googleplay?p\u003dappgame_ratings"]]],[[[[[null,[[0,"USD",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dai.perplexity.app.android\u0026rdid\u003dai.perplexity.app.android\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]]],["Install"],null,["CgYKBENBRT0\u003d"]]]],[2],null,[1,1,0],["$4.99 - $1,999.99 per item",[0]]],[["com.videoeditorpro.android",7],[null,2,[512,512],[null,null,"https://play-lh.googleusercontent.com/VsZmyZfd62uNwIDoF3OAoBgWeidT9EatxNZpVOo6sA7aIKlm6EzIWdIeAjCvAcBFj8xZE0TBxRqeJeMQgv8ciA"],null,[32,31,33,255],null,null,null,2],[[null,2,[1280,720],[null,null,"https://play-lh.googleusercontent.com/y0d4Oftxg6SLL3_bV8i6XwgnyZrFMDQD-766E1ccmHRoZVHGnmyEG_UFk4FQ44Up81bzKJmNbOEz62gDU-xXaw"]],[null,2,[1280,720],[null,null,"https://play-lh.googleusercontent.com/UmlOhrUpJ9rTAS-SBPBP5LlNsjI6sAwGnlb5GhOMTLxRdzpCG1gRWAJkl16RiTPsJKSMQevv1D37FOkyeXa0lQ