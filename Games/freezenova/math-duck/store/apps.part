55515],"Social",null,null,[null,[[0,"USD",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dsg.bigo.live\u0026rdid\u003dsg.bigo.live\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,"/store/apps/details?id\u003dsg.bigo.live"]],["qgJfGl0IABIUChIKDHNnLmJpZ28ubGl2ZRABGANKEwiajMDtn+mWAxWopYMDHWqpE62aARMImK/JvPnolgMVhqKDAx01jiI2+gEXChUIqu2hvdy7x4tDEgkKBWVuLVVTEAA\u003d"],null,[null,"BIGO LIVE - The Ultimate Live Streaming Platform\u003cbr\u003eJoin over 700M people worldwide on BIGO LIVE, where entertainment meets connection.\u003cbr\u003e\u003cbr\u003e\u003cfont color\u003d\"#300F77\"\u003e\u003cb\u003eWhat You Can Enjoy:\u003c/b\u003e\u003c/font\u003e\u003cbr\u003e√ Discover Exciting Live Streams: Watch high-quality, round-the-clock streams tailored to your interests, from chatting, dancing, and singing to gaming and beyond.\u003cbr\u003e√ Feel the Warm Community Vibes: Step into any live room to enjoy friendly chats, instant interactions, and warm welcomes from a vibrant global community.\u003cbr\u003e√ Create Meaningful Connections: Break the ice with video chats, voice calls, or fun interactive games, and build friendships that truly matter.\u003cbr\u003e√ Shine as a Star: Do what you love—whether it\u0026#39;s sharing your talents or simply chatting. Get applause, followers, and rewards, even without showing your face.\u003cbr\u003e\u003cbr\u003e\u003cfont color\u003d\"#300F77\"\u003e\u003cb\u003eKey Features:\u003c/b\u003e\u003c/font\u003e\u003cbr\u003e- LiveStreams: Swipe to explore live streams across various categories and engage in real-time with virtual gifts and live chats.\u003cbr\u003e- Multi-guest Live (Live Video Chat): Team up with up to 11 friends, watch YouTube videos together, discuss trending topics, and enjoy games like \u0026quot;Draw and Guess.\u0026quot;\u003cbr\u003e- Audio Live (Live Voice Chat): Meet interesting people worldwide through audio-only conversations, anytime and anywhere.\u003cbr\u003e- Live PK: Compete with friends or enjoy as a viewer, experiencing exciting penalties for the losing team in fun-filled challenges.\u003cbr\u003e- Go Live: Start streaming with one tap, choosing from Game LIVE, Audio LIVE, or Multi-guest LIVE to share your world in your style.\u003cbr\u003e\u003cbr\u003e\u003cfont color\u003d\"#300F77\"\u003e\u003cb\u003eWhy Choose BIGO LIVE?\u003c/b\u003e\u003c/font\u003e\u003cbr\u003e√ 10+ Years of Excellence\u003cbr\u003e√ Trusted by 700M Users\u003cbr\u003e√ 4,600+ Five-Star Reviews\u003cbr\u003e√ Featured in Top Media Like Forbes\u003cbr\u003e√ Available in Over 150 Countries and Regions\u003cbr\u003e\u003cbr\u003e\u003cfont color\u003d\"#300F77\"\u003e\u003cb\u003eStay Connected:\u003c/b\u003e\u003c/font\u003e\u003cbr\u003eFacebook: https://www.facebook.com/bigoliveapp\u003cbr\u003eInstagram: https://www.instagram.com/bigoliveapp\u003cbr\u003e\u003cbr\u003eHave feedback? Contact us at feedback@bigo.tv"],"Bigo Technology Pte. Ltd.","500,000,000+",null,"",null,null,null,null,[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/p243lW9K71gN9K83bJ9GJKm9vu3_Cyn5T34myaNz-D6K4EIdzo-oyE66J86HC514k-DY7DG_OtknZkX8RTTzqg"],null,[251,251,252,255]],null,["Teen",[null,2,[512,512],[null,null,"https://play-lh.googleusercontent.com/mw_NfsvKM8m6RPv8Fz2GQawCOsqWv010saMnc7zbWalMxuaA9IY8h7E0VMieLxSxAFB98NFeYqbFrXXq"]],[null,"Diverse Content: Discretion Advised"],[null,"Users Interact, Shares Location, In-App Purchases (Includes Random Items)"],[null,"\u003ca href\u003d\"https://support.google.com/googleplay?p\u003dappgame_ratings\"\u003eLearn more\u003c/a\u003e"],0,null,[null,2,[272,272],[null,null,"https://play-lh.googleusercontent.com/xl04GurQer374yogi24hRkvUcXtMStMOcOo86Sprmrid9j6wQHF0d9xMh73CwUEg57lbsGIwpOXgrJ927Q"]],[null,null,null,null,null,[null,null,"https://support.google.com/googleplay?p\u003dappgame_ratings"]]],[[[[[nu