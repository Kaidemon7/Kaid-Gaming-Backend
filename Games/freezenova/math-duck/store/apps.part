//play-lh.googleusercontent.com/pZj8t2iDFCTF0xPVs3wKO8ss-vxFKHgSdoc0n4M00XMYzDKVcAWLtNOgQs9BUnd09z9aeTh-ah-Sf3Mk_Eh9gg"]],[null,2,[2752,2064],[null,null,"https://play-lh.googleusercontent.com/gAbEbHRFN5yXFIfO1FA5uA7G1XgSDZ9-VQst6vS08XVwopH5mpmrQZaB9kqNbeuBouyE42t6Bj-fpUW_JHdq"]],[null,2,[2752,2064],[null,null,"https://play-lh.googleusercontent.com/JRmw7ExYCuTf93uKkswbxAW0SWlsZEwge_AobFLRyAvp056tD-A3WaWkD2E0V29DHqykiH9r2PZKHeRR90Ifhw"]],[null,2,[2752,2064],[null,null,"https://play-lh.googleusercontent.com/RPQAddB4oUqkLUChXV6LtrQtZbFWdmuJbGp4tpLSptgMBdTexFiDQUKCU_7uivJyDNt9DUHtIb1gscWtGrX1dQ"]],[null,2,[2752,2064],[null,null,"https://play-lh.googleusercontent.com/pZj8t2iDFCTF0xPVs3wKO8ss-vxFKHgSdoc0n4M00XMYzDKVcAWLtNOgQs9BUnd09z9aeTh-ah-Sf3Mk_Eh9gg"]]],"Focus Friend by Hank Green",["4.9",4.9041095],"Productivity",null,null,[null,[[0,"USD",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.underthing.focus.friend\u0026rdid\u003dcom.underthing.focus.friend\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,"/store/apps/details?id\u003dcom.underthing.focus.friend"]],["qgJQGk4IABIjCiEKG2NvbS51bmRlcnRoaW5nLmZvY3VzLmZyaWVuZBABGANKEwiajMDtn+mWAxWopYMDHWqpE636AQ8KDQgAEgkKBWVuLVVTEAA\u003d"],null,[null,"Focus Friend is a cozy, gamified focus timer created by online educator Hank Green!\u003cbr\u003e\u003cbr\u003eWhen you Focus, your Bean Friend will Focus. If you interrupt your Bean by turning off the timer, they\u0026#39;ll be really really sad.\u003cbr\u003e\u003cbr\u003eComplete your focus session, and this cute Bean will give you prizes to buy decorations to help furnish their room.\u003cbr\u003e\u003cbr\u003ePerfect for anyone who struggles with long sessions of concentration. Focus Friend is for students and beyond.\u003cbr\u003e\u003cbr\u003eFeatures:\u003cbr\u003e- Live Activity: See your timer progress when your phone is locked\u003cbr\u003e- Deep Focus Mode: Lock distracting apps during your focus sessions\u003cbr\u003e- Break Timers: Decorate on your breaks, using the Pomodoro method of productivity\u003cbr\u003e- Hundreds of decorations: Decorate your room in different fun themes\u003cbr\u003e- Bean Skins: Try on different Bean types to customize your Focus Friend (Coffee Bean, Edamame Bean, Pinto Bean, Kitty Bean, or even Hank and John Green... Or rather Hank and John Bean!)\u003cbr\u003e\u003cbr\u003eFocus Friend will even help you with getting started on your tasks and getting into the flow of your work or studying or even chores.\u003cbr\u003e\u003cbr\u003eStay Focused, Have Fun, Drink Water, and Don\u0026#39;t Forget to be Awesome~"],"Honey B Games","1,000,000+",null,"",null,null,null,null,[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/4L2Oi2v0baAfKgjt2yWKIraYR45QbDZ90houx2z9G6uVP6hyeqtf_Q9mz-mKxZ75DcVpVyOdvn1dSNQvBWyHrQ"],null,[238,229,198,255]],null,["Everyone",[null,2,[512,512],[null,null,"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i"]],null,[null,"In-App Purchases"],[null,"\u003ca href\u003d\"https://support.google.com/googleplay?p\u003dappgame_ratings\"\u003eLearn more\u003c/a\u003e"],0,null,[null,2,[272,272],[null,null,"https://play-lh.googleusercontent.com/OBVqgRK7eerY0GPfK8AOzitu5oE9ecC6kG4kURTCb1K41gpqVsN0WjmJwJh-wX8vILzpcc1kYHt56aLN2g"]],[null,null,null,null,null,[null,null,"https://support.google.com/googleplay?p\u003dappgame_ratings"]]],[[[[[null,[[0,"USD",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.underthing.focus.friend\u0026rdid\u003dcom.underthing.focus.friend\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]]],["Install"],null,["CgYKBENBRT0\u003d"]]]],[2],null,[1,1,0],["$0.99 - $39.99 per item",[0]]],[["com.learningstrategy",7],[null,2,[512,512],[null,null,"https://play-lh.googleusercontent.com/DlJebT1LqA8wmqA9ygrPi3Zs-66hzIfIkeHBq42ALHAJXuw2jqzokd-VZo7Jc21vGhzUMhBeNHo1Mj8paedUEA"],null,[123,72,255,255],null,null,null,2],[[null,2,[2208,1242],[null,null,"https://play-lh.googleusercontent.com/B-4q3noqKD_GzQ7txyvuCN0mYcxmfYpvpvrkhvd1XiCI7CoVax1XFGHx0vt9C172hJ-_TgNLGo90v-nOS2fqWKw"]],[null,2,[2208,1242],[null,null,"https://play-lh.googleusercontent.com/eiOrbUPA2Jyl7zUurVtEOJvqtLVF18cxMDJjhsyCA71RU_wKbZRgDtL8CcuYcX_odD4qiZKu_eSkLPMXSg_f"]],[null,2,[2208,1242],[null,null,"https://play-lh.googleusercontent.com/I5sANWcypp6dzVRd0zBZL8bGlQufPD0UO-FwLggZBn5lytLZa1ElYC18eWnlAb39UhwzsdQ7qnti8drzdm08gA"]],[null,2,[2208,1242],[null,null,"https://play-lh.googleusercontent.com/_wJjXJOGTKWDKOmLxZ9YQcjS6NXPWBe_ZU_-7JNo6s9HrMZ6m-wiOe7UlG7nwhD4lAbT-W99Ep8tqzja8QBE"]],[null,2,[2208,1242],[null,null,"https://play-lh.googleusercontent.com/zEMMtMJkazk51h5_k6vVExc8olPY6tGDTcn15esYS6ix_q4wZpwinP655DmH6NNXxD7D5tswr7Je7v2Veju5"]],[null,2,[2208,1242],[null,null,"https://play-lh.googleusercontent.com/afXfaYCSfo2N5kFWBAthyfD5wGpVABAo6iieu0DW9OKVpUkJdyQbPkyu8knpLq14BHeONaPQVVCiT6e6kZMku6s"]],[null,2,[2208,1242],[null,null,"https://play-lh.googleusercontent.com/bQJcRQUr8LBEOl_eu49TSJG7u0fwsrl21nTR6Dlagj-4pXB6GB5n32ecUf6CzKLSq7Sbtjkn10zV3jiSv7_W"]],[null,2,[2208,1242],[null,null,"https://play-lh.googleusercontent.com/6lOwy_tMOl_YDixdO2s69S73FjkmPmUjT6N4OOBPKl5bSi71jRZomU6rZflt_88tHKtqOzrkIjVYKByQ-HzFTw"]]],"MINDTRX: Self Help \u0026 Mindset",["3.8",3.84],"Health \u0026 Fitness",null,null,[null,[[0,"USD",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.learningstrategy\u0026rdid\u003dcom.learningstrategy\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,"/store/apps/details?id\u003dcom.learningstrategy"]],["qgJJGkcIARIcChoKFGNvbS5sZWFybmluZ3N0cmF0ZWd5EAEYA0oTCJqMwO2f6ZYDFailgwMdaqkTrfoBDwoNCAASCQoFZW4tVVMQAA\u003d\u003d"],null,[null,"MINDTRX: Transform Your Life with Self-Help \u0026amp; Personal Development\u003cbr\u003e\u003cbr\u003eWith MINDTRX audios, you can improve any aspect of your life in just 20 minutes a day—even while you’re sleeping! Tap play, close your eyes, think of what you want, and drift into a peaceful world of relaxing music, nature sounds, and transformative words. Your mind will gently begin learning how to serve you, helping you manifest your desires and achieve your goals.\u003cbr\u003e\u003cbr\u003eOur unique sessions, called Paraliminals, are designed to work with your nonconscious mind (inner mind, subconscious mind) to promote self-development, personal growth, and self-transformation. Millions of people have already used these powerful tools for over 35 years to unlock their full potential.\u003cbr\u003e\u003cbr\u003ePopular Paraliminals include:\u003cbr\u003e\u003cbr\u003eAbundant Money Mindset\u003cbr\u003eFive Elements Healing\u003cbr\u003eIdeal Weight\u003cbr\u003eFearlessness\u003cbr\u003eAnxiety-Free\u003cbr\u003eSelf-Love\u003cbr\u003eSleep Deeply/Wake Refreshed\u003cbr\u003eSelf-Esteem Supercharger\u003cbr\u003eThese are just a few examples of the tools that will help you manifest your dreams and cultivate the mindset you need to succeed. Subliminal messages, hypnosis, and NLP techniques are integrated into each session to help you achieve personal development, break through mental blocks, and improve your overall well-being.\u003cbr\u003e\u003cbr\u003eMINDTRX is designed for anyone who seeks freedom and transformation—freedom from procrastination, low self-esteem, anxiety, bad habits, stress, and lack of focus. With MINDTRX, you can experience greater health, enhanced energy, improved relationships, and a stronger sense of calm and mindfulness.\u003cbr\u003e\u003cbr\u003eWhether you are looking to enhance your focus, improve your habits, manifest your dreams, or achieve personal growth, MINDTRX provides the tools you need to reach your goals. It’s not just about motivation—it’s about self-growth and personal transformation.\u003cbr\u003e\u003cbr\u003eIn addition to the Paraliminals, MINDTRX features life-coaching videos, self-improvement courses, goal setting tools, and the exclusive SLEEPTRX program.\u003cbr\u003e\u003cbr\u003eOur world-renowned experts include Paul R. Scheele, Jack Canfield, Marci Shimoff, Lisa Nichols, Brian Tracy, JJ Virgin, Hale Dwoskin, Lynne Twist, and many more.\u003cbr\u003e\u003cbr\u003e• Auto-renewable subscription\u003cbr\u003e\u003cbr\u003eTotally free for 3 days. Then billed annually. Your subscription will be charged to your iTunes account at confirmation of purchase and will automatically renew (at the duration selected) unless auto-renew is turned off at least 24 hours before the end of the current period.\u003cbr\u003e\u003cbr\u003eCurrent subscription may not be cancelled during the active subscription period; however, you can manage your subscription and/or turn off auto-renewal by visiting your iTunes Account Settings after purchase."],"Genius Mind LLC","50,000+",null,"",null,null,null,null,[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/UiyeJ6B6vFddNsLg1QySTdclxortQAsZR0KyRm5kMSvZpTqspEIgxis0Os4FP4U8LnWRV6VdgX-Ocf0LIc-T"],null,[252,252,252,255]],null,["Everyone",[null,2,[512,512],[null,null,"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i"]],null,null,[null,"\u003ca href\u003d\"https://support.google.com/googleplay?p\u003dappgame_ratings\"\u003eLearn more\u003c/a\u003e"],0,[null,"Content is generally suitable for all ages. May contain minimal cartoon, fantasy or mild violence and/or infrequent use of mild language."],[null,2,[272,272],[null,null,"https://play-lh.googleusercontent.com/OBVqgRK7eerY0GPfK8AOzitu5oE9ecC6kG4kURTCb1K41gpqVsN0WjmJwJh-wX8vILzpcc1kYHt56aLN2g"]],[null,null,null,null,null,[null,null,"https://support.google.com/googleplay?p\u003dappgame_ratings"]]],[[[[[null,[[0,"USD",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.learningstrategy\u0026rdid\u003dcom.learningstrategy\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]]],["Install"],null,["CgYKBENBRT0\u003d"]]]],[2],null,[1,1,0],["$11.99 - $99.00 per item",[0]]],[["com.cron.calendar",7],[null,2,[512,512],[null,null,"https://play-lh.googleusercontent.com/G8SNJSKLUURNjERYSl221bKfgOqItnuxyR6w_0nKiS6o4Zjs1QpU6Oo4oA3GN_GNXZ9KDiSR4awprJeJHgznYQ"],null,[254,254,254,255],null,null,null,2],[[null,2,[2992,1344],[null,null,"https://play-lh.googleusercontent.com/u-NRUkYqh-mGeBaBlaTTYeZDJcT6bY_U9ClMsl9XmekuZrYKwAaOxb_o4O_EtNcyDPwf7jMPk570ASAFYYv2TIM"]],[null,2,[2992,1344],[null,null,"https://play-lh.googleusercontent.com/afWTx9Sz-T4K5MN1lYtfXXMV_PA02ZDRhA3fp_R67vAV92_IvahlngHjJ4WlUF5-Cr_a_IGstnhJZYotIrZr1g"]],[null,2,[2992,1344],[null,null,"https://play-lh.googleusercontent.com/0T0NqCCYvwYbc46ScsQaoFjTuiPrikX_n5GwFt8anqj572YkEr7mKnq5ZDL_sDSLW2UvXuRQyLN8GGN0aPi9qg"]],[null,2,[2992,1344],[null,null,"https://play-lh.googleusercontent.com/UCKgurRO8iQvWoB4TDkgmf5PlgtzgJ6pwYsFOTLsV377CWQFOG7ReqPsai7dwRT_9H232DvzWIuhdNFg3tJ6"]]],"Notion Calendar",["3.3",3.3357143],"Productivity",null,null,[null,[[0,"USD",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.cron.calendar\u0026rdid\u003dcom.cron.calendar\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,"/store/apps/details?id\u003dcom.cron.calendar"]],["qgJGGkQIAhIZChcKEWNvbS5jcm9uLmNhbGVuZGFyEAEYA0oTCJqMwO2f6ZYDFailgwMdaqkTrfoBDwoNCAASCQoFZW4tVVMQAA\u003d\u003d"],null,[null,"Notion Calendar lets you schedule meetings and control your time like never before. It deeply integrates with Google Calendar accounts so that all your events are synced.\u003cbr\u003e\u003cbr\u003eAlong with speed, beauty, and light/dark modes, Notion Calendar includes powerful features:\u003cbr\u003e\u003cbr\u003e- CONNECTED TO NOTION — add Notion docs, projects, and timelines.\u003cbr\u003e- MULTIPLE TIME ZONES — pull the time zone column to the right to “travel to any city” and add more time zones.\u003cbr\u003e- ALL IN ONE PLACE — see one unified view across multiple calendars and auto-sync events between them.\u003cbr\u003eWIDGETS — featuring multiple sizes, rich previews of upcoming events, and a quick-add event button.\u003cbr\u003e- AVAILABLE IN 12 LANGUAGES — Japanese, Korean, French, German, Spanish, Portuguese, Danish, Dutch, Finnish, Norwegian, and Swedish.\u003cbr\u003e\u003cbr\u003eIt’s time."],"Notion Labs, Inc.","1,000,000+",null,"",null,null,null,null,[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/DPOwKCKmCGMDs9dlYGdjQiVXL8BHF5VVWKPDtIoM9UOu_-u1cBpz42qrXCb5t3l6f5to-Ua9M8sYD2wiDBpSDg"],null,[254,254,254,255]],null,["Everyone",[null,2,[512,512],[null,null,"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i"]],null,null,[null,"\u003ca href\u003d\"https://support.google.com/googleplay?p\u003dappgame_ratings\"\u003eLearn more\u003c/a\u003e"],0,[null,"Content is generally suitable for all ages. May contain minimal cartoon, fantasy or mild violence and/or infrequent use of mild language."],[null,2,[272,272],[null,null,"https://play-lh.googleusercontent.com/OBVqgRK7eerY0GPfK8AOzitu5oE9ecC6kG4kURTCb1K41gpqVsN0WjmJwJh-wX8vILzpcc1kYHt56aLN2g"]],[null,null,null,null,null,[null,null,"https://support.google.com/googleplay?p\u003dappgame_ratings"]]],[[[[[null,[[0,"USD",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.cron.calendar\u0026rdid\u003dcom.cron.calendar\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]]],["Install"],null,["CgYKBENBRT0\u003d"]]]],[2],null,[1,1,0]],[["com.somashare",7],[null,2,[512,512],[null,null,"https://play-lh.googleusercontent.com/7v2p8MxSVh3DelVz3bdPDDRCMXjPGRFkv6rVCbnb3H6pvc7Dc7xlfyHmN-ff-v40DSbHKRiQqCHbihG94tRM"],null,[105,85,160,255],null,null,null,2],[[null,2,[1600,738],[null,null,"https://play-lh.googleusercontent.com/4gGng-nWo6R7Ht9LN_7oc5bnY5xR5SjQ6RMsUZ5GGrVJvfrbU7oubXklqVNvks0NnppgMlIh2kZbXupR5yB_xg"]],[null,2,[1600,738],[null,null,"https://play-lh.googleusercontent.com/RY-eAcGieOS5U4X-VjW8SkT8esR94po6fEy-pC8lgvETxWuY1Yr4lV6z98Rarttz-VPv50KuiUmDSaElLB5N"]],[null,2,[1600,738],[null,null,"https://play-lh.googleusercontent.com/lkiZkDXBiEOGBwZurVa3tzztun2bSieFZ5W4DgR8bRWpd283kpFbuTAQKsINee2ciMESTP1CKpn6tYPmKWOT2Fc"]],[null,2,[1600,738],[null,null,"https://play-lh.googleusercontent.com/pb2q2ulrlgWVKz3m-hZdT-cKjtgpxjIuzfHMG2uoJ3XWv6w-zpa1irTDDWXV2skYcLNegcX5kjkB3oJAa9bcpQ"]],[null,2,[1600,738],[null,null,"https://play-lh.googleusercontent.com/FYDp1V7DHueJA-8SZCIAhv3PVBXa-RKGO6cazhtTKDrgmOTRCAuSrWlNHWgUO4yPhcN_RRowcUP7kecV9jlWtw"]],[null,2,[1600,738],[null,null,"https://play-lh.googleusercontent.com/UFfbcX4tAda8h_j4F7650LQFtLcLaPRvFcKmnLoaR2lpQcDbFI3Rx4o8MBhTEPmBALMNNMYiVtnhVOLmvWsC"]],[null,2,[1600,738],[null,null,"https://play-lh.googleusercontent.com/I82uqEGnc1hxLcxjTLeBYJOQh63AN-8ntV0Lpj5lrQC_CzLdvpYUt7miI0uBC9dAdpKhvhzwNw7-3IsPme1Y1w"]]],"SomaShare - Deep Healing",["4.4",4.4],"Health \u0026 Fitness",null,null,[null,[[0,"USD",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.somashare\u0026rdid\u003dcom.somashare\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,"/store/apps/details?id\u003dcom.somashare"]],["qgJCGkAIAxIVChMKDWNvbS5zb21hc2hhcmUQARgDShMImozA7Z/plgMVqKWDAx1qqROt+gEPCg0IABIJCgVlbi1VUxAA"],null,[null,"◦ Healing practices and community \u003cbr\u003eSomaShare was founded to support your healing journey by providing you with practices you can do daily to heal and regulate your nervous system. \u003cbr\u003e\u003cbr\u003e\u003cbr\u003e\u003cbr\u003eYou’ll also be part of a community where you can share your progress and feelings. \u003cbr\u003e\u003cbr\u003e\u003cbr\u003e\u003cbr\u003e◦ Experience powerful shifts: \u003cbr\u003eBy practicing with our incredible, hand picked practitioners who stand out in their field, you can begin to experience powerful shifts in your stress levels, moods, and behaviors over time.\u003cbr\u003e\u003cbr\u003e\u003cbr\u003e\u003cbr\u003e◦ Trauma-informed \u003cbr\u003eOur focus is on bringing you trauma informed practitioners who understand the impact of overwhelming past experiences on the body, soul and spirit. \u003cbr\u003e\u003cbr\u003e\u003cbr\u003e\u003cbr\u003eThis means you won’t be pushed, encouraged to go at your own pace and to accept your experience for exactly what it is in the present moment.\u003cbr\u003e\u003cbr\u003e\u003cbr\u003e\u003cbr\u003eSome of the types of practices you can find on SomaShare:\u003cbr\u003e◦ Emotional healing: Practices for emotional healing and integration of past stress and trauma \u003cbr\u003e◦ Regulating your nervous system: Practices for more presence and grounding, moving through states like overwhelm, anxiety or shutdown and into inner alignment and peace\u003cbr\u003e◦ Feel more pleasure: Practices to tune into your inherent pleasure, joy, expansion and aliveness \u003cbr\u003e◦ Change your patterns \u0026amp; habits: Practices to move from habits and patterns you feel stuck in and into more freedom and flexibility in your life  \u003cbr\u003e◦ Setting aligned goals: Practices to help you set goals in alignment with your values and who you are, goals that feel right in your body and spirit\u003cbr\u003e◦ Profound Anxiety Relief: Practices to support you in embracing and learning from anxiety, as well as experiencing relief in the somatic symptoms of it\u003cbr\u003e\u003cbr\u003e\u003cbr\u003eSome of the types of practices you will find include: \u003cbr\u003e- yoga nidra\u003cbr\u003e- somatic grounding and nervous system regulation\u003cbr\u003e- anxiety relief\u003cbr\u003e- somatic experiencing\u003cbr\u003e- creating safety in the body \u003cbr\u003e- spiritual growth\u003cbr\u003e- self connection\u003cbr\u003e- and more!"],"SomaShare LLC","50,000+",null,"",null,null,null,null,[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/5JgX5KQrbmVldc4cTFEzhRkzz9f7zMVqwHre3p4U5cWdIg_k1Ohnsbmw5iq-E3A5tfMYBVkJaawyhszuA5Qlbg"],null,[254,254,254,255]],null,["Everyone",[null,2,[512,512],[null,null,"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i"]],null,[null,"Users Interact, In-App Purchases"],[null,"\u003ca href\u003d\"https://support.google.com/googleplay?p\u003dappgame_ratings\"\u003eLearn more\u003c/a\u003e"],0,null,[null,2,[272,272],[null,null,"https://play-lh.googleusercontent.com/OBVqgRK7eerY0GPfK8AOzitu5oE9ecC6kG4kURTCb1K41gpqVsN0WjmJwJh-wX8vILzpcc1kYHt56aLN2g"]],[null,null,null,null,null,[null,null,"https://support.google.com/googleplay?p\u003dappgame_ratings"]]],[[[[[null,[[0,"USD",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.somashare\u0026rdid\u003dcom.somashare\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]]],["Install"],null,["CgYKBENBRT0\u003d"]]]],[2],null,[1,1,0],["$59.99 per item",[0]]],[["app.coconote",7],[null,2,[512,512],[null,null,"https://play-lh.googleusercontent.com/FVzE4B_zfDz9l3FV13qPrFqL4tPKOYTkhGid4Ag559HjZbcUONNlVw3XW1J2nNOlseJlcgkUfK3OkXs21kV0"],null,[252,252,251,255],null,null,null,2],[[null,2,[3840,2160],[null,null,"https://play-lh.googleusercontent.com/SqHGqK1P09Kl7NKrj2em5Vj51y_zbVR3DhKtc8XnS3o5guIC0hB87xDVqdY7kmS1yhdi1GrMdtp1nISDbWHwMQ"]],[null,2,[3840,2160],[null,null,"https://play-lh.goog