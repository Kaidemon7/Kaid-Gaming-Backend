1920],[null,null,"https://play-lh.googleusercontent.com/jCZ-QHkyHPeemxRIRQ5G-mifxO9BJs7gOsdKycB81Doh-RgEv6Ghk2ciYbMXKNTCENJ_9yAAgjXKEjPXtnP39hg"]],[null,2,[1080,1920],[null,null,"https://play-lh.googleusercontent.com/CFBojgyLXCeiXG0JMPMw695RpXQ6mZiMdHafJnxMaKNqq-uXPxbxV5c3C8fac3-n0XEYo8F1k6DaULkNBm7e_A"]],[null,2,[1280,800],[null,null,"https://play-lh.googleusercontent.com/w_th56J-8_7P1q6X3jOhI6j5ivXfx07qffAFSi7DHbiErZzj18PK2LOggk0Uo1FFtX1nECyytT5WVUFXorJgHA"]],[null,2,[768,1024],[null,null,"https://play-lh.googleusercontent.com/3Q16DFchCpTGZhd41uAsk_LANgPMPiJOIkcfeERqDfLrR1m2_Zyhu4vkj5Nr7mr8YR9fcNI71Stf38UOsQ_B"]],[null,2,[768,1024],[null,null,"https://play-lh.googleusercontent.com/IxlxmqYobMzHonswfkWUy8AIfY1eONrLqKee1GbsaHhriy8GpaMLBFj5JcVYYZTpU8OcOth5GwNiM-DLcBTJfg"]],[null,2,[1280,800],[null,null,"https://play-lh.googleusercontent.com/bcWkxdATwAMyj0Rzf3ZjNT2tYn41ot40QfQzjIN4qMDbxTqZmF198jqT2lhdxan9ho0xvpYEa7mt_2z0p3eWKA"]]],"HBO Max: Stream TV \u0026 Movies",["4.8",4.8025413],"Entertainment",null,null,[null,[[0,"USD",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.wbd.stream\u0026rdid\u003dcom.wbd.stream\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,"/store/apps/details?id\u003dcom.wbd.stream"]],["qgJhGl8IChIWChQKDmNvbS53YmQuc3RyZWFtEAEYA0oTCJqMwO2f6ZYDFailgwMdaqkTrZoBEwiYr8m8+eiWAxWGooMDHTWOIjb6ARcKFQiSrcjPoLDiiUMSCQoFZW4tVVMQAA\u003d\u003d"],null,[null,"The most talked about shows and movies featuring the worlds of HBO, the DC Universe, Adult Swim, A24, and beyond.\u003cbr\u003e\u003cbr\u003eWith HBO Max you\u0026#39;ll get:\u003cbr\u003e• Access to thousands of TV shows and movies.\u003cbr\u003e• Exclusive, award-winning series that everyone\u0026#39;s talking about — like the HBO Originals The Last of Us, Succession, The White Lotus, and House of the Dragon.\u003cbr\u003e• The latest hits from HBO, Harry Potter, DC, Warner Bros., ID, Adult Swim, A24, and more.\u003cbr\u003e• Stream select live sports from your favorite leagues and teams. Availability varies by plan and by subscription provider.\u003cbr\u003e• Iconic favorite TV shows like Friends, Rick and Morty, Gossip Girl, 90 Day Fiancé, Looney Tunes, and more.\u003cbr\u003e• Family-friendly entertainment for the whole household.\u003cbr\u003e• Fascinating documentaries and true crime series.\u003cbr\u003e\u003cbr\u003eFeatures:\u003cbr\u003e• Enjoy your favorite shows and movies at home or on the go. HBO Max is available on select TV, web browser, mobile, tablet, and gaming console devices.  \u003cbr\u003e• Catch even more sports action with the live Multiview experience — stream up to 3 games at once during select events.\u003cbr\u003e• Browse or search with ease across HBO, movies, series, genres, and brands.\u003cbr\u003e• Download shows and movies you love to watch on the go with select plans. (Download limits vary by plan.)\u003cbr\u003e• Personalized profiles for the entire household with customizable ratings, profile PIN protection, and kid-proof exit.\u003cbr\u003e• Pick up episodes and movies where you left off across your favorite devices.\u003cbr\u003e• Keep up with everything you love, all in one place with My Stuff.\u003cbr\u003e• Watch on multiple devices at the same time. (Limits vary by plan.)\u003cbr\u003e• Stream with high-quality video and surround sound on select plans.\u003cbr\u003e\u003cbr\u003eContent and feature availability on HBO Max may vary by region. Some titles and features shown above may not be available in your country. Language availability varies by country.\u003cbr\u003e\u003cbr\u003eYou can manage or cancel your subscription by visiting Settings \u0026gt; Subscriptions in your HBO Max account. HBO Max is only available in certain territories.\u003cbr\u003e\u003cbr\u003eTerms of Use: https://hbomax.com/terms-of-use"],"WarnerMedia Global Digital Services, LLC","100,000,000+",null,"",null,null,null,null,[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/lchjbp31VOVvI5JOExa07AGjgJEbBUDSxC17SPM6P7T3-94OGlw0wrezrJSznSLAtT0YSt4hDHm8eVs6Uc5LBw"],null,[18,23,33,255]],null,["Teen",[null,2,[512,512],[null,null,"https://play-lh.googleusercontent.com/mw_NfsvKM8m6RPv8Fz2GQawCOsqWv010saMnc7zbWalMxuaA9IY8h7E0VMieLxSxAFB98NFeYqbFrXXq"]],[null,"Diverse Content: Discretion Advised"],[null,"In-App Purchases"],[null,"\u003ca href\u003d\"https://support.google.com/googleplay?p\u003dappgame_ratings\"\u003eLearn more\u003c/a\u003e"],0,null,[null,2,[272,272],[null,null,"https://play-lh.googleusercontent.com/xl04GurQer374yogi24hRkvUcXtMStMOcOo86Sprmrid9j6wQHF0d9xMh73CwUEg57lbsGIwpOXgrJ927Q"]],[null,null,null,null,null,[null,null,"https://support.google.com/googleplay?p\u003dappgame_ratings"]]],[[[[[null,[[0,"USD",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.wbd.stream\u0026rdid\u003dcom.wbd.stream\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]]],["Install"],null,["CgYKBENBRT0\u003d"]]]],[2],null,[1,1,0],["$2.49 - $229.99 per item",[0]]],[["com.starmakerinteractive.starmaker",7],[null,2,[512,512],[null,null,"https://play-lh.googleusercontent.com/fcFo4Yt5XaiKetmDIjbx0C2IiJT1lNzRvqBrEO4LbgQB_jYJksaNwvvLvWltJAuBCPprCmPEwTpbrJl_6TEOlXM"],null,[141,72,228,255],null,null,null,2],[[null,2,[1920,1080],[null,null,"https://play-lh.googleusercontent.com/aCIHiOO8SoUAd9wf4net9e66XMWQSNN8Rwr8HEZZJrOhjsv8tLiVA2FXAUGnKtlkS3fVtyW6VIMkDCwW4CkdrQ"]],[null,2,[1920,1080],[null,null,"https://play-lh.googleusercontent.com/I-Hc3OYnA2nHGwR35Y5ZzbUXigsUhfW6ZWALHwuijluFNJL7hqhvwiJDA3iycyJdg61y9GRDQBVYUlsiUXZ0sg"]],[null,2,[1920,1080],[null,null,"https://play-lh.googleusercontent.com/15DSsRmNiujMPc4zieWfuhnJySSj8vkLNmN1Cn40DcgafUTIFfXc-sVfqaK82zEFAO9UC7BEI0OcP1K-LaQwNw"]],[null,2,[1920,1080],[null,null,"https://play-lh.googleusercontent.com/KAGeQRrHVEJYSFC8JlLSsoir3CYgotFsEob84XZiL-284iz032FjKgWN2HrW_irh1GibW0-dPSsrotenv-7Z"]],[null,2,[1920,1080],[null,null,"https://play-lh.googleusercontent.com/1doNPSazDrrWcZO21tC5cOrq-9LlSFr8TiQukpXteGsKbrPxE71ef-I9-9ogki15eSuHvELgrbX6LSLkFGfR"]],[null,2,[1920,1080],[null,null,"https://play-lh.googleusercontent.com/Df025kwJgPy-ig6UXq_FoouzXfsGav790P5wqKk57BUl4HFiu57_XSAvZEa8742d2worZ4ZGTKbIQrP-jqUTpXw"]]],"StarMaker: Sing Karaoke Songs",["4.4",4.378316],"Music \u0026 Audio",null,null,[null,[[0,"USD",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.starmakerinteractive.starmaker\u0026rdid\u003dcom.starmakerinteractive.starmaker\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,"/store/apps/details?id\u003dcom.starmakerinteractive.starmaker"]],["qgJtGmsICxIqCigKImNvbS5zdGFybWFrZXJpbnRlcmFjdGl2ZS5zdGFybWFrZXIQARgDShMImozA7Z/plgMVqKWDAx1qqROtmgETCJivybz56JYDFYaigwMdNY4iNvoBDwoNCAASCQoFZW4tVVMQAA\u003d\u003d"],[[[null,null,"iYYYztqG1HA",[null,null,"https://play.google.com/video/lava/web/player/yt:movie:iYYYztqG1HA?autoplay\u003d1\u0026embed\u003dplay"],"yt:movie:iYYYztqG1HA",null,null,null,null,"AXH1ezn6DIhTqqhgIsGHQXjS164N0M0n4sNkHEQz9M0lem44S_VnjgE7GzGAqpl7KXyDMOB-keHz0DLiKBvJIWzmuubO6MPWVK6FaiATbqkj75iJYgPMFd4CFWWWD6BqZKaHjoA-WdIrIj-T_TqUsz9PE8oywyUp8sSgli5pvg_sfOi6R9R-6cSHNBpLvR08X2LtOM-kDQ7luR6Ra1GQ87xb7z4wsNKxT4cPvgldbFG7m51EUi8LYf93m9a3goa3yA6t25izF7r39fnetOZNS7eDS1vPqh2qOS1n-lC8N4V1tQ\u003d\u003d"],null,1,[null,null,null,[null,null,"https://i.ytimg.com/vi/iYYYztqG1HA/hqdefault.jpg"]]]],[null,"Want more music-loving friends? Bring out the singer in you in StarMaker——The popular Karaoke App is featured by Google Play🏆\u003cbr\u003e\u003cb\u003eStarMaker is a popular singing app and music community with 50M+ users globally! Sing karaoke songs, share your special music moments and enjoy the community!\u003c/b\u003e\u003cbr\u003e\u003cbr\u003e🎤Sing Karaoke Songs\u003cbr\u003eNo matter if you like Pop, Hip Hop, R\u0026amp;B, or Folk, you can now pick your favorites from millions of songs, sing along with the high-quality backing music and rolling lyrics, edit your recordings with professional video filters,voice and audio editor. Share on social platforms like Whatsapp, Facebook, Instagram, Twitter, Snapchat and more.\u003cbr\u003eAlso, you can now duet with top artists and sing together with a group of friends just like a superstar! Be a star and start your own music concerts! \u003cbr\u003e\u003cbr\u003e📌 Professional Sound Effects\u003cbr\u003eWe have a professional music team. The audio editor function is constantly updated so that you can hear more interesting music. The singing function keep optimizing, the lyrics display is smoother, and the singing experience is better.\u003cbr\u003e\u003cbr\u003e🎧Interaction\u003cbr\u003eWe support different ways of interacting. You can create rooms and enjoy singing and playing at any time. This is such an amazing experience! You can even see who is the best player or listen king of singing in the room!\u003cbr\u003e\u003cbr\u003eWe have added many new features for a better experience! Such as:\u003cbr\u003e🎤 Pick your favorite songs and latest hits from millions of local and international songs with rolling lyrics.\u003cbr\u003e🎤 Record with professional audio editor, using special effects like Distant, Warm, Vinyl, Party, Fascinating, etc.\u003cbr\u003e🎤 Edit your selfie music videos with beautiful filters like Vintage, Paris, Sunset, Urban, Spring, etc.\u003cbr\u003e🎤 Use pitch correction with audio editor to make you sound like a pro singer.\u003cbr\u003e🎤 Use video template to create unique MVs and display lyrics in a more gorgeous way.\u003cbr\u003e🎤 Listen to top cover songs and download music to enjoy.\u003cbr\u003e🎤 ‘Hook’ allows you to sing the best part of your favorite songs! Duet with top artists or friends and make a recording together!\u003cbr\u003e🎤 Join a ‘Family’ community to play with other music lovers who share the same tastes as you.\u003cbr\u003e🎤 Play various sing games in rooms.\u003cbr\u003e\u003cbr\u003e\u003cb\u003e Sing and listen from all the hit songs now Including:\u003c/b\u003e\u003cbr\u003e+ Ordinary - Alex Warren\t\u003cbr\u003e+ back to friends - sombr\t\u003cbr\u003e+ Die With A Smile - Lady Gaga, Bruno Mars\t\u003cbr\u003e+ BIRDS OF A FEATHER - Billie Eilish\t\u003cbr\u003e+ Don\u0026#39;t Say You Love Me - Jin\t\u003cbr\u003e+ La Plena - W Sound 05 - W Sound, Beéle, Ovy On The Drums\t\u003cbr\u003e+ APT. - ROSÉ, Bruno Mars\t\u003cbr\u003e+ undressed - sombr\t\u003cbr\u003e+ Love Me Not - Ravyn Lenae\t\u003cbr\u003e+ Just Keep Watching (From F1® The Movie) - Tate McRae, F1 The Album\t\u003cbr\u003e+ WILDFLOWER - Billie Eilish\t\u003cbr\u003e+ Who - Jimin\t\u003cbr\u003e\u003cbr\u003eSTAY CONNECTED!\u003cbr\u003eHaving trouble singing or using the app? Contact our support team through email: appsupport@starmakerinteractive.com\u003cbr\u003eWe’ll be happy to help and answer all your questions!\u003cbr\u003eVisit our official website: \u003cbr\u003ehttps://www.starmakerstudios.com/en\u003cbr\u003eFollow us on TikTok:\u003cbr\u003ehttps://www.tiktok.com/@starmaker_officialpage\u003cbr\u003eFollow us on Instagram:\u003cbr\u003ehttps://www.instagram.com/starmaker.official.account\u003cbr\u003eSubscribe to our YouTube channel:\u003cbr\u003ehttps://www.youtube.com/@StarMakerNetwork\u003cbr\u003eJoin us on Facebook:\u003cbr\u003ehttps://www.facebook.com/starmaker\u003cbr\u003e\u003cbr\u003ePlay with the StarMaker App! To sing, to play, to connect!\u003cbr\u003e\u003cbr\u003e※ Permissions\u003cbr\u003e[Optional]\u003cbr\u003e- Storage: Save photos and videos from StarMaker to your device.\u003cbr\u003e- Contacts: Access your device\u0026#39;s contacts and add friends.\u003cbr\u003e- Photos/Media: Access your gallery, take photos, and record videos.\u003cbr\u003e- Microphone: Recording and playback for singing, in Party Rooms, or live streams.\u003cbr\u003e- Location: Location-based services, such as adding friends based on location.\u003cbr\u003e- Calendar: Add Activity reminders to your calendar.\u003cbr\u003e- Bluetooth: Connect to wireless audio devices (for recording, playback, etc.).\u003cbr\u003e\u003cbr\u003e* You can still use the app even if you do not grant optional permissions.\u003cbr\u003e* If you choose not to grant optional permissions, some features may not work properly."],"SKYWORK AI PTE. LTD.","500,000,000+",null,"",null,null,null,null,[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/1ARnzwyy--OkJJz3e7u2IvUsWtEN94Rdd3Qd_8DxkQd1_QcFlLU6oTMdNOo1_ShGcWxyJMLwy9Mb45tXaZLGcA"],null,[65,9,155,255]],null,["Teen",[null,2,[512,512],[null,null,"https://play-lh.googleusercontent.com/mw_NfsvKM8m6RPv8Fz2GQawCOsqWv010saMnc7zbWalMxuaA9IY8h7E0VMieLxSxAFB98NFeYqbFrXXq"]],[null,"Diverse Content: Discretion Advised"],[null,"Users Interact, In-App Purchases"],[null,"\u003ca href\u003d\"https://support.google.com/googleplay?p\u003dappgame_ratings\"\u003eLearn more\u003c/a\u003e"],0,null,[null,2,[272,272],[null,null,"https://play-lh.googleusercontent.com/xl04GurQer374yogi24hRkvUcXtMStMOcOo86Sprmrid9j6wQHF0d9xMh73CwUEg57lbsGIwpOXgrJ927Q"]],[null,null,null,null,null,[null,null,"https://support.google.com/googleplay?p\u003dappgame_ratings"]]],[[[[[null,[[0,"USD",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.starmakerinteractive.starmaker\u0026rdid\u003dcom.starmakerinteractive.starmaker\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]]],["Install"],null,["CgYKBENBRT0\u003d"]]]],[2],null,[1,1,0],["$0.49 - $199.99 per item",[0]]],[["com.spotify.music",7],[null,2,[512,512],[null,null,"https://play-lh.googleusercontent.com/IzQgYCcnCFCD08GR-3bdtcT8xzOvrNkC84avGT5CwTX2VIqmTmKKJcP_Cd4JoBOdmCMlTndlOzV6hrthg2fOWA