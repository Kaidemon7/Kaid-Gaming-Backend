6eYAXx1kvX7Fmt5g0rmhgObHgQHrZKs-hwBy40ACTBIjrmD3B77Uy0PBfr0d_dSeBg"]],[null,2,[2752,2064],[null,null,"https://play-lh.googleusercontent.com/NfmIH9M7V3qjPIjb9iLZqrxkeZ8_tC5zuUN-D5aqtHJPGNBNxMUiw-bXuJmX-dnUN33D87dRjrWLIKSfAMPhaQ"]],[null,2,[2752,2064],[null,null,"https://play-lh.googleusercontent.com/5eerodhSr9tYIEWzV6IxgYBLQIy7Th2odNdyx4jiJknTxVqL8RW1GSMBcdMuN5tvP_Y1il1ymL4c7LgDEEa9Iw0"]],[null,2,[2752,2064],[null,null,"https://play-lh.googleusercontent.com/t7YR_429uDWZCmZ1MejOLD1VgX_5e8T6tYDyGmuKgosdeCdFXqgADyHY5QFGjuQ5eLAMXNweFMyPuMC553WM"]],[null,2,[2752,2064],[null,null,"https://play-lh.googleusercontent.com/u2s7ZjFS4bVuyryYyGHf11S0q1kpzsSTdqlvmlGfY-DkUfK3HCaARPw3u6e8SAZ2DTi3maymPTWmwha5Tty-iA"]]],"Insight: Micro Book Summaries",["4.3",4.31],"Books \u0026 Reference",null,null,[null,[[0,"USD",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003djournal.ai.com\u0026rdid\u003djournal.ai.com\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,"/store/apps/details?id\u003djournal.ai.com"]],["qgJDGkEIBRIWChQKDmpvdXJuYWwuYWkuY29tEAEYA0oTCJqMwO2f6ZYDFailgwMdaqkTrfoBDwoNCAASCQoFZW4tVVMQAA\u003d\u003d"],null,[null,"Book summaries that you actually use.\u003cbr\u003e\u003cbr\u003eInsight Books turns nonfiction book summaries into daily micro learning: read the key ideas in 15 minutes, then get a specific action to try today. Because knowing isn\u0026#39;t enough. Doing is everything.\u003cbr\u003e\u003cbr\u003eTHE PROBLEM WITH BOOK SUMMARIES\u003cbr\u003e\u003cbr\u003eYou\u0026#39;ve tried Blinkist. Headway. Maybe others.\u003cbr\u003e\u003cbr\u003eYou read summary after summary. You feel productive. A week later you can\u0026#39;t remember a single insight, and nothing in your life has changed.\u003cbr\u003e\u003cbr\u003eThat\u0026#39;s because passive reading doesn\u0026#39;t stick - your brain forgets most of what you read within 48 hours.\u003cbr\u003e\u003cbr\u003eInsight Books fixes this.\u003cbr\u003e\u003cbr\u003eACTIVE LEARNING, NOT JUST BOOK SUMMARIES\u003cbr\u003e\u003cbr\u003eMost book summaries give you information. Insight Books gives you a system for self improvement you can run every day.\u003cbr\u003e\u003cbr\u003eREAD - key insights from a nonfiction book in 15 minutes\u003cbr\u003eREFLECT - guided questions that make the idea yours\u003cbr\u003eACT - one practical, actionable step for today\u003cbr\u003eTRACK - watch your growth over weeks, not minutes\u003cbr\u003e\u003cbr\u003eMICRO LEARNING THAT FITS A REAL DAY\u003cbr\u003e\u003cbr\u003e15-minute sessions built for a commute, a lunch break, or the last few minutes before bed. Daily micro learning beats an hour you never find.\u003cbr\u003e\u003cbr\u003eWHAT YOU GET\u003cbr\u003e\u003cbr\u003eActionable book summaries\u003cbr\u003eEvery nonfiction summary ends with specific actions. Read the habits classic, walk away with three habits to start tomorrow - not just theory.\u003cbr\u003e\u003cbr\u003eThousands of nonfiction book summaries\u003cbr\u003eSelf improvement classics and the latest releases:\u003cbr\u003e- Psychology and mindset\u003cbr\u003e- Business and leadership\u003cbr\u003e- Habits and behavior change\u003cbr\u003e- Health and wellness\u003cbr\u003e- Personal growth and philosophy\u003cbr\u003e\u003cbr\u003eAudio book summaries\u003cbr\u003eListen to the key ideas hands-free while you walk, drive, or train.\u003cbr\u003e\u003cbr\u003eAn AI mentor for your reading\u003cbr\u003eAsk questions about any book summary and get answers grounded in the ideas you just read, plus personalized recommendations based on your goals.\u003cbr\u003e\u003cbr\u003eGrowth tracking\u003cbr\u003eInsights learned, actions taken, books completed. Progress you can see.\u003cbr\u003e\u003cbr\u003eMental models and decision-making\u003cbr\u003eDecision frameworks, cognitive techniques, and the thinking tools behind better choices.\u003cbr\u003e\u003cbr\u003eWHY PEOPLE SWITCH\u003cbr\u003e\u003cbr\u003eOther book summary apps: read and forget\u003cbr\u003eInsight Books: read, reflect, and do\u003cbr\u003e\u003cbr\u003eOther apps: passive consumption\u003cbr\u003eInsight Books: an active learning system\u003cbr\u003e\u003cbr\u003eOther apps: information overload\u003cbr\u003eInsight Books: actionable wisdom\u003cbr\u003e\u003cbr\u003ePERFECT FOR YOU IF\u003cbr\u003e\u003cbr\u003e- You want book summaries that change something, not just fill time\u003cbr\u003e- You are serious about self improvement and short on hours\u003cbr\u003e- You learn by doing, not only by reading\u003cbr\u003e- You want daily micro learning instead of another unfinished book\u003cbr\u003e\u003cbr\u003eSTOP COLLECTING INSIGHTS. START USING THEM.\u003cbr\u003e\u003cbr\u003eYour next 15 minutes can be one book summary, one insight, one action.\u003cbr\u003e\u003cbr\u003eTerms of Use: https://insightbooks.app/terms\u003cbr\u003ePrivacy Policy: https://insightbooks.app/privacy"],"UofHappy, LLC","100,000+",null,"",null,null,null,null,[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/omcz-oQ0DXSTmC52Lz0iy5LZ31d-2FZbS89j-JyHUjIkkg47d3lSl2T3S9e4EDCbG3oMCY4lOwdUTP1Z1G6O5g"],null,[254,254,254,255]],null,["Teen",[null,2,[512,512],[null,null,"https://play-lh.googleusercontent.com/mw_NfsvKM8m6RPv8Fz2GQawCOsqWv010saMnc7zbWalMxuaA9IY8h7E0VMieLxSxAFB98NFeYqbFrXXq"]],[null,"Diverse Content: Discretion Advised"],[null,"In-App Purchases"],[null,"\u003ca href\u003d\"https://support.google.com/googleplay?p\u003dappgame_ratings\"\u003eLearn more\u003c/a\u003e"],0,null,[null,2,[272,272],[null,null,"https://play-lh.googleusercontent.com/xl04GurQer374yogi24hRkvUcXtMStMOcOo86Sprmrid9j6wQHF0d9xMh73CwUEg57lbsGIwpOXgrJ927Q"]],[null,null,null,null,null,[null,null,"https://support.google.com/googleplay?p\u003dappgame_ratings"]]],[[[[[null,[[0,"USD",""]],null,[null,"Buy"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003djournal.ai.com\u0026rdid\u003djournal.ai.com\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]]],["Install"],null,["CgYKBENBRT0\u003d"]]]],[2],null,[1,1,0],["$6.99 - $35.99 per item",[0]]],[["com.knowt.app",7],[null,2,[512,512],[null,null,"https://play-lh.googleusercontent.com/LykeMmXTweuRubfbzrXOB-0vXMpKsIie4Vr6dAi1WlW8Qx_vNY-tjuG7WyreyoHyiuh6_rvRP43l4EChi6coBw"],null,[80,210,194,255],null,null,null,2],[[null,2,[1920,1080],[null,null,"https://play-lh.googleusercontent.com/srI_QxYQrCg19ko0ejUhzGF0XFVquq1h7zyRtQfEsUaXyzyxEeSeS4E2yr5KXaArqgEb7fBGP7Bgi7Z9XaFC2iQ"]],[null,2,[1920,1080],[null,null,"https://play-lh.googleusercontent.com/k8y_hOB13wRQL3gyG_KFhhMlyZchg9P39LhS5rfx64d5TPDG2jfGX-iDIBoTzwBhd38ZCNQH9gUMmYBuXm6RgQ"]],[null,2,[1920,1080],[null,null,"https://play-lh.googleusercontent.com/jTRrvgMmkzCEPHQJfQalo44TtTrxFmvWO2ctnFGX5ry_YbvoYstvfJiXthG4Zxo3cQQ1DRIiomGOHw_hWTLFUPc"]],[null,2,[1920,1080],[null,null,"https://play-lh.googleusercontent.com/frR_j4XNpAYlrOVvN9J3NdIDOwGaED5awPsNHR1PsoCJO6aDJwsxPSWnzP7xCDHLlnq2gGYqEGyKNiwFq6K0"]],[null,2,[1920,1080],[null,null,"https://play-lh.googleusercontent.com/gc8QymgXadTMchcBQq_zIXUrdzwhyZI356cTtdIMuiYOC4j4hnMHXFQ5CgJKP3tN5rUNpp5Pb2EAqXFguheR"]],[null,2,[1920,1080],[null,null,"https://play-lh.googleusercontent.com/WYlA2uYAkru3GeL2wwlM435gSeibHcUpk_k2Up16Q9QQI7ZYUlOk-iVym8r_zW4d6r38h-2xyy2XTtI5oEce"]],[null,2,[1920,1080],[null,null,"https://play-lh.googleusercontent.com/q-4iXg7_pXHqx3QVyFZVedEDrHY099FmJLBkLc2zExRduYpUYaGrvXCcQPhQsmpojhEUiWBORe24Uo2_10oK7g"]],[null,2,[1920,1080],[null,null,"https://play-lh.googleusercontent.com/LWW_14Bihhz8wD9ap9JXY1e22A2J8qtKlVm9IKhf36rRu_BrIrG83TJk0OojXMNykNXY6lRjkex98vbjVqH5"]],[null,2,[2064,2752],[null,null,"https://play-lh.googleusercontent.com/oaGoGvnhgsMPme_wgjvFDeZ6eWNXSChvD0r85FZd446bKkYtx6qIqrFyDjAxwUKGLR_3lx5282PqPb_YIFTL"]],[null,2,[2064,2752],[null,null,"https://play-lh.googleusercontent.com/vNn71dSdLitkEYxF